#!/usr/bin/env bash
# On a host reached via kitten ssh: ul <laptop-files...> <remote-dest>
host=$(hostname -s)

# herdr (and other multiplexers) swallow kitty's file-transfer escape (OSC 5113);
# put a laptop-side scp command on the clipboard via OSC 52 instead.
if [[ -n $HERDR_ENV || -n $TMUX || -n $ZELLIJ ]]; then
  (($# >= 2)) || { echo "usage: ul <laptop-files...> <remote-dest>" >&2; exit 2; }
  dest=$(realpath -m -- "${@: -1}")
  cmd="scp -r"
  for f in "${@:1:$#-1}"; do
    # This shell already expanded ~ to the remote home; give the laptop its own ~
    [[ $f == "$HOME"/* ]] && cmd+=" ~/$(printf '%q' "${f#"$HOME"/}")" || cmd+=" $(printf '%q' "$f")"
  done
  cmd+=" $host:$(printf '%q' "$dest")"
  printf '\e]52;c;%s\a' "$(printf '%s' "$cmd" | base64 -w0)"
  echo "ul: kitten transfer doesn't work inside a multiplexer. Run this on the laptop (copied to clipboard):" >&2
  echo "  $cmd" >&2
  exit 1
fi

exec kitten transfer --direction=upload "$@"
