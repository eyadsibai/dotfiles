#!/usr/bin/env bash
# video2mp3 <videos...>: saves each video's audio as an mp3 beside it (talk.mkv gives
# talk.mp3), at LAME's V2 quality (variable bitrate, about 190 kbps).
set -euo pipefail
(($#)) || { echo "usage: video2mp3 <videos...>" >&2; exit 2; }

for f in "$@"; do
  # Only the file's own extension goes, not a dot further up the path
  name=${f##*/}
  ffmpeg -hide_banner -loglevel warning -stats -i "$f" -vn -q:a 2 "${f%"$name"}${name%.*}.mp3"
done
