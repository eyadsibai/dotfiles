# cava in a terminal. Colours: the Omarchy theme's, written to themes/omarchy by
# the theme-set hook (40-cava.sh); `theme` is already set, so the hook leaves
# this linked file alone.
[general]
framerate = 60
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = noncurses

[color]
theme = 'omarchy'

[smoothing]
noise_reduction = 70
