{
  "bar": {
    "background": "opaque",
    "layout": {
      "center": [
        {
          "birthYear": 1985,
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "cities": [
            {
              "name": "Riyadh",
              "zone": "Asia/Riyadh"
            },
            {
              "name": "San Francisco",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "UTC",
              "zone": "Etc/UTC"
            },
            {
              "name": "Istanbul",
              "zone": "Asia/Istanbul"
            }
          ],
          "hour24": true,
          "id": "omarchy.elsewhen",
          "units": "C"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "eyad.meetplanner",
          "meetingMinutes": 60
        }
      ],
      "centerEnd": [
        {
          "id": "local.prayer-times"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "eyad.cava"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "37signals.hey"
        },
        {
          "exec": "newsboat-unread --bar",
          "id": "news",
          "interval": 60,
          "onClick": "omarchy-launch-or-focus-tui newsboat",
          "onMiddleClick": "systemctl --user start newsboat-refresh",
          "onRightClick": "omarchy-launch-or-focus-tui newsboat-yt",
          "type": "command"
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "eyad.media"
        },
        {
          "id": "eyad.tv"
        },
        {
          "id": "eyad.meetings"
        },
        {
          "id": "flux"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "disabledPlugins": [
    "omarchy.dock"
  ],
  "dock": {
    "autohide": true,
    "position": "bottom"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "omakade.guide"
    }
  ],
  "version": 1
}
