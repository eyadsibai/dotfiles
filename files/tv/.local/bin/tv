#!/usr/bin/env bash
# tv — live TV in mpv.
#
#   tv                  resume the last-watched channel (or start at channel 1)
#   tv <N>              start on channel number N
#   tv <name>           start on the first channel whose name contains <name>
#   tv -l|--list [q]    list channels (number, group, name), optionally filtered
#   tv --dump           list channels tab-separated: number, group, name, url
#   tv --check [args]   run tv-check (probe the playlist; --prune / --revive channels)
#   tv --pip [N|name]   a second, muted TV pinned in a corner (or switch the open one)
#   tv --bar [--pip]    the playing channel as Omarchy bar JSON; nothing when TV isn't running
#   tv --ctl <action>   menu | next | prev | last | star | mute | unmute | quit | play <N>,
#                       sent to the running TV; --pip-ctl sends it to the corner one
#   tv --swap           the corner TV and the main one trade windows and roles (Hyprland)
#   tv -h|--help
#
# Anything after "--" is passed to mpv, e.g.  tv mbc1 -- --fullscreen
# Playlist: $TV_M3U (default ~/.config/tv/tv.m3u), which nothing here writes to. mpv plays
# tv-check's copy of it without the pruned channels (~/.local/state/tv/playing.m3u),
# rebuilt on every start. Player behaviour is the [tv] profile in
# ~/.config/mpv/tv/tv.conf plus ~/.config/mpv/tv/tv.lua.
# The grouped channel menu needs uosc (Arch: mpv-uosc). When the mpv config doesn't
# autoload it, tv loads $TV_UOSC (default /usr/share/mpv/scripts/uosc) for TV only.
#
# Keys while watching:
#   ENTER / c   channel menu (by category, type to search)  0-9  jump to channel
#   PGUP/PGDN   previous / next channel                     r    reload channel
#   / or S-ENTER  all channels, search                      q    quit
#   TAB         last channel                                s    star (favorite)
#   - / + =     volume down / up                            m/M  mute
#   a           sound to the other TV, or back              x    swap it with the other TV
# Menus and the channel banner take the Omarchy theme's colours and font.

set -euo pipefail

PLAYLIST="${TV_M3U:-${XDG_CONFIG_HOME:-$HOME/.config}/tv/tv.m3u}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tv"
LAST_FILE="$STATE_DIR/last"

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/tv"
# Each player gets its own socket, named after its pid ($$: exec keeps it). Roles
# can swap between the two players, so the role files (now.json, pip.json) say
# whose socket is whose.
SOCKET="$RUN_DIR/mpv-$$.sock"

usage() { sed -n '2,/^$/p' "$0" | sed -e 's/^# \{0,1\}//' -e '/^$/d'; }

die() { printf 'tv: %s\n' "$1" >&2; exit 1; }

# Prints one line per channel of $PLAYING: N<TAB>group<TAB>name<TAB>url, numbered the way mpv
# numbers playlist entries (every non-comment, non-blank line is one entry).
list_channels() {
  awk '
    function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    { sub(/\r$/, "") }
    /^#EXTINF/ {
      # name = text after the first comma outside a quoted attribute value (a
      # plain first-comma split breaks on values containing commas). tv.lua and
      # tv-check use the same rule; tests/parsers.sh checks they agree.
      title = ""; quoted = 0
      for (i = 1; i <= length($0); i++) {
        ch = substr($0, i, 1)
        if (ch == "\"") quoted = !quoted
        else if (ch == "," && !quoted) { title = trim(substr($0, i + 1)); break }
      }
      # iptv-org uses "A;B" for multi-category channels; file them under the first
      group = ""
      if (match($0, /group-title="[^"]*"/)) group = substr($0, RSTART + 13, RLENGTH - 14)
      sub(/;.*/, "", group); group = trim(group)
      next
    }
    /^[[:space:]]*$/ || /^#/ { next }
    { n++; url = trim($0)
      printf "%d\t%s\t%s\t%s\n", n, (group == "" ? "Other" : group), (title == "" ? url : title), url
      title = ""; group = "" }
  ' "$PLAYING"
}

# 1-based channel number for a URL, or nothing. The awk never exits early: closing
# the pipe while list_channels is still writing raises SIGPIPE, which `set -o pipefail`
# turns into a silent non-zero exit of the whole launcher.
index_of_url() {
  list_channels | awk -F'\t' -v u="$1" '!n && $4 == u { n = $1 } END { if (n) print n }'
}

# 1-based channel number of the first name containing the query (case-insensitive).
index_of_name() {
  list_channels | awk -F'\t' -v q="$1" \
    'BEGIN { q = tolower(q) } !n && index(tolower($3), q) { n = $1 } END { if (n) print n }'
}

# The corner TV (tv --pip) has its own socket and state file, so the main one's
# last channel, recent list and bar widget stay its own.
PIP=""
if [ "${1:-}" = --pip ]; then PIP=1; shift; fi

# role_socket main|pip: the socket of the live player in that role, or nothing.
role_socket() {
  local file="$RUN_DIR/now.json" pid sock
  if [ "$1" = pip ]; then file="$RUN_DIR/pip.json"; fi
  [ -r "$file" ] || return 1
  pid="$(grep -o '"pid": *[0-9]*' "$file" | grep -o '[0-9]*$' || true)"
  { [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; } || return 1
  sock="$(grep -o '"socket": *"[^"]*"' "$file" | sed 's/.*"\([^"]*\)"$/\1/' || true)"
  [ -S "$sock" ] || return 1
  printf '%s\n' "$sock"
}

# send_ctl <socket> <action> [args]: a script message to a running TV; fails when
# nothing answers on the socket.
send_ctl() {
  python3 -c 'import json, socket, sys
s = socket.socket(socket.AF_UNIX)
try:
    s.connect(sys.argv[1])
except OSError:
    sys.exit(1)
s.sendall((json.dumps({"command": ["script-message", "tv-" + sys.argv[2], *sys.argv[3:]]}) + "\n").encode())' "$@"
}

# The bar polls --bar every few seconds, so it and --ctl skip the channel list.
case "${1:-}" in
  --bar)
    # tv.lua writes now.json (pip.json for the corner TV) on every channel change
    # and removes it on quit; a crash leaves it behind, so its pid has to be alive too.
    now="$RUN_DIR/now.json"
    if [ "${2:-}" = --pip ]; then now="$RUN_DIR/pip.json"; fi
    [ -r "$now" ] || exit 0
    pid="$(grep -o '"pid": *[0-9]*' "$now" | grep -o '[0-9]*$' || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then cat "$now"; fi
    exit 0 ;;
  --ctl|--pip-ctl)
    role=main
    if [ "$1" = --pip-ctl ]; then role=pip; fi
    case "${2:-}" in
      menu|next|prev|last|star|mute|unmute|quit) ;;
      play) [[ "${3:-}" =~ ^[0-9]+$ ]] || die "usage: tv --ctl play <channel number>" ;;
      *) die "usage: tv --ctl|--pip-ctl menu|next|prev|last|star|mute|unmute|quit|play <N>" ;;
    esac
    sock="$(role_socket "$role")" || die "TV isn't running"
    # The menu opens in TV's window, so bring that forward first.
    if [ "$2" = menu ] && command -v hyprctl >/dev/null; then
      pid="$(basename "$sock" .sock)"; pid="${pid#mpv-}"
      hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"pid:$pid\" }))" >/dev/null 2>&1 || true
    fi
    send_ctl "$sock" "${@:2}" || die "TV isn't running"
    exit 0 ;;
  --swap)
    # The two players trade windows (Hyprland) and then roles, so nothing
    # reopens a stream: the corner one grows into the main window with the sound.
    command -v hyprctl >/dev/null || die "--swap needs Hyprland"
    python3 - "$RUN_DIR" <<'EOF' || exit 1
import json, os, socket, subprocess, sys

run = sys.argv[1]

def role(name):
    try:
        with open(f"{run}/{name}.json") as f:
            data = json.load(f)
        os.kill(data["pid"], 0)
        return data
    except Exception:
        return None

def send(sock, *args):
    s = socket.socket(socket.AF_UNIX)
    s.connect(sock)
    s.sendall((json.dumps({"command": ["script-message", *args]}) + "\n").encode())
    s.close()

main, pip = role("now"), role("pip")
if not main or not pip:
    sys.exit("tv: --swap needs both TVs open (tv --pip opens the corner one)")
clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, check=True).stdout)
by_pid = {c["pid"]: c for c in clients}
big, small = by_pid.get(main["pid"]), by_pid.get(pip["pid"])
if not big or not small:
    sys.exit("tv: can't find both TV windows")

B, S = f'"address:{big["address"]}"', f'"address:{small["address"]}"'
(x, y), (w, h) = small["at"], small["size"]
full = {1: "maximized", 2: "fullscreen"}.get(big.get("fullscreen", 0))
lua = []
if full:
    lua.append(f'hl.dispatch(hl.dsp.window.fullscreen({{ mode = "{full}", action = "unset", window = {B} }}))')
# the big window shrinks into the corner, pinned
lua += [f'hl.dispatch(hl.dsp.window.float({{ action = "on", window = {B} }}))',
        f'hl.dispatch(hl.dsp.window.pin({{ action = "on", window = {B} }}))',
        f'hl.dispatch(hl.dsp.window.resize({{ x = {w}, y = {h}, relative = false, window = {B} }}))',
        f'hl.dispatch(hl.dsp.window.move({{ x = {x}, y = {y}, window = {B} }}))']
# the corner window takes the big one's place: its workspace, tiled or floating as it was
lua += [f'hl.dispatch(hl.dsp.window.pin({{ action = "off", window = {S} }}))',
        f'hl.dispatch(hl.dsp.window.move({{ workspace = "{big["workspace"]["id"]}", follow = false, window = {S} }}))']
if big["floating"]:
    (bx, by), (bw, bh) = big["at"], big["size"]
    lua += [f'hl.dispatch(hl.dsp.window.resize({{ x = {bw}, y = {bh}, relative = false, window = {S} }}))',
            f'hl.dispatch(hl.dsp.window.move({{ x = {bx}, y = {by}, window = {S} }}))']
else:
    lua.append(f'hl.dispatch(hl.dsp.window.float({{ action = "off", window = {S} }}))')
if full:
    lua.append(f'hl.dispatch(hl.dsp.window.fullscreen({{ mode = "{full}", action = "set", window = {S} }}))')
lua.append(f'hl.dispatch(hl.dsp.focus({{ window = {S} }}))')
subprocess.run(["hyprctl", "eval", "\n".join(lua)], capture_output=True, check=True)

# then roles: the new main one takes the sound, last channel, recent and the bar
send(pip["socket"], "tv-role", "main")
send(main["socket"], "tv-role", "pip")
EOF
    exit 0 ;;
esac

[ -r "$PLAYLIST" ] || die "playlist not found: $PLAYLIST"

TV_CHECK="$(dirname "$0")/tv-check"
case "${1:-}" in
  -h|--help|--check) ;;
  *) PLAYING="$("$TV_CHECK" --sync -p "$PLAYLIST")" || die "could not build the channel list from $PLAYLIST" ;;
esac

start_index=""   # 0-based, for --playlist-start
chosen=""        # a channel was named on the command line
case "${1:-}" in
  -h|--help)
    usage; exit 0 ;;
  -l|--list)
    shift
    if [ $# -gt 0 ]; then
      list_channels | awk -F'\t' -v q="$*" 'BEGIN { q = tolower(q) } index(tolower($3), q) || index(tolower($2), q)'
    else
      list_channels
    fi | awk -F'\t' '{ printf "%4d  %-26s  %s\n", $1, $2, $3 }'
    exit 0 ;;
  --dump)
    list_channels; exit 0 ;;
  --check)
    shift; exec "$TV_CHECK" "$@" ;;
  --)
    shift ;;
  '')
    if [ -r "$LAST_FILE" ]; then
      idx="$(index_of_url "$(head -n1 "$LAST_FILE")")"
      # A remembered channel that has since been pruned just means "start at 1".
      if [ -n "$idx" ]; then start_index=$((idx - 1)); fi
    fi ;;
  -*)
    die "unknown option $1 (use -- before mpv options)" ;;
  *)
    query="$1"; shift; chosen=1
    if [[ "$query" =~ ^[0-9]+$ ]]; then
      count="$(list_channels | wc -l)"
      [ "$query" -ge 1 ] && [ "$query" -le "$count" ] || die "channel $query is out of range (1-$count)"
      start_index=$((10#$query - 1))
    else
      idx="$(index_of_name "$query")"
      [ -n "$idx" ] || die "no channel name contains '$query' (try: tv --list $query)"
      start_index=$((idx - 1))
    fi
    if [ "${1:-}" = "--" ]; then shift; fi ;;
esac

# A corner TV already open just switches to the channel asked for.
if [ -n "$PIP" ] && pip_sock="$(role_socket pip)"; then
  if [ -z "$chosen" ]; then
    send_ctl "$pip_sock" noop 2>/dev/null && exit 0   # already open: nothing to do
  elif send_ctl "$pip_sock" play "$((start_index + 1))" 2>/dev/null; then
    exit 0
  fi
fi

# Load the [tv] profile here rather than from mpv.conf, so installing is just `stow tv`.
args=("--include=~~/tv/tv.conf" --profile=tv "--playlist=$PLAYING")
# For `tv --ctl`; one TV at a time owns it.
mkdir -p "$RUN_DIR"
args+=("--input-ipc-server=$SOCKET" "--script-opts-append=tv-launcher=$0")
# The corner TV: muted, its own app id (the hypr package floats and pins it), and
# tv.lua's pip mode, which keeps the main TV's state alone.
if [ -n "$PIP" ]; then
  args+=(--wayland-app-id=mpv-tv-pip --mute=yes --script-opts-append=tv-pip=yes)
fi
# The Omarchy font for uosc's menus and the banner ($TV_FONT overrides; empty: mpv's).
font="${TV_FONT-$(omarchy-font-current 2>/dev/null || true)}"
[ -n "$font" ] && args+=("--osd-font=$font")
[ -n "$start_index" ] && args+=("--playlist-start=$start_index")

# uosc draws the grouped channel menu; without it tv.lua falls back to mpv's flat
# playlist picker. Use the mpv config's uosc when it autoloads one, else load the
# installed copy, replacing mpv's OSC and OSD bar as uosc expects. Either way its
# icon font has to be in mpv's fonts dir, or every icon is drawn as its name.
MPV_DIR="${MPV_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/mpv}"
UOSC="${TV_UOSC:-/usr/share/mpv/scripts/uosc}"
uosc_fonts="${UOSC%/scripts/*}/fonts"
autoloaded=""
for dir in "$MPV_DIR" /etc/mpv; do
  if [ -e "$dir/scripts/uosc.lua" ] || [ -e "$dir/scripts/uosc/main.lua" ]; then autoloaded=1; fi
done
if [ -z "$autoloaded" ] && [ -r "$UOSC/main.lua" ]; then
  args+=("--script=$UOSC" --osc=no --osd-bar=no)
fi
if [ ! -e "$MPV_DIR/fonts/uosc_icons.otf" ] && [ -e "$uosc_fonts/uosc_icons.otf" ]; then
  args+=("--osd-fonts-dir=$uosc_fonts")
fi

exec mpv "${args[@]}" "$@"
