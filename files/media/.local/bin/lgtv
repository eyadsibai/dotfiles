#!/usr/bin/env -S uv run -q --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["websockets>=13", "pillow"]
# ///
"""lgtv — control the LG webOS TV from this machine.

  lgtv status                 power state, foreground app, volume
  lgtv on | off               power on (Wake-on-LAN) / off
  lgtv screen off|on          blank the panel, keep sound (and back)
  lgtv vol [N|up|down]        show or set volume
  lgtv mute | unmute
  lgtv play|pause|stop|ff|rew media controls
  lgtv input [N|name]         list inputs, or switch (lgtv input 2 = HDMI 2)
  lgtv apps                   list installed apps
  lgtv app <name|id>          launch an app (e.g. lgtv app shahid)
  lgtv open <url>             open a URL in the TV browser
  lgtv youtube <url|id>       play a video in the YouTube app (as the phone's cast button does)
  lgtv ytsearch <query>       search YouTube; one JSON line per video (id, title, channel, ...)
  lgtv notify <message>       show a toast on the TV
  lgtv key <KEY>...           press remote keys (UP DOWN LEFT RIGHT ENTER BACK HOME ...)
  lgtv type [--enter] <text>  type into the TV's on-screen keyboard (e.g. a search box)
  lgtv gridtype [--replace] <text>
                              type on Plex's, Prime Video's or Shahid's own letter grid;
                              --replace clears their search box first
  lgtv remote                 interactive remote in this terminal; typing goes to the
                              TV when its keyboard is open, c toggles a mouse pointer
  lgtv pipe                   one connection driven from stdin, for the bar widget:
                              key NAME · move DX DY · click · scroll DY · text STR ·
                              enter · del [N] · seek SECS · wake (screen back on); prints
                              {"keyboard": bool}, {"app", "grid"}, {"power"} and
                              {"playing"} as they change. Text goes to Plex's, Prime's
                              or Shahid's letter grid when one of them is on screen.
                              playing (and seek) is YouTube only: the video, its
                              length and where it is, each second it plays
  lgtv cast <file|url>...     play videos on the TV (the cast service, DLNA)
  lgtv pair                   (re)pair; accept the prompt on the TV
  lgtv host                   print the TV's address

Config and pairing key live in ~/.config/lgtv/. LGTV_HOST overrides the TV address.
"""
import asyncio
import json
import os
import pathlib
import re
import socket
import ssl
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
import uuid

CONF_DIR = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "lgtv"
KEYFILE = CONF_DIR / "client-key"
CONFFILE = CONF_DIR / "config.json"
MDNS_NAME = "LGwebOSTV.local"

PERMISSIONS = [
    "LAUNCH", "LAUNCH_WEBAPP", "APP_TO_APP", "CLOSE", "TEST_OPEN", "TEST_PROTECTED",
    "CONTROL_AUDIO", "CONTROL_DISPLAY", "CONTROL_INPUT_JOYSTICK", "CONTROL_INPUT_MEDIA_RECORDING",
    "CONTROL_INPUT_MEDIA_PLAYBACK", "CONTROL_INPUT_TV", "CONTROL_POWER", "CONTROL_TV_SCREEN",
    "CONTROL_TV_STANBY", "CONTROL_MOUSE_AND_KEYBOARD", "CONTROL_INPUT_TEXT",
    "READ_APP_STATUS", "READ_CURRENT_CHANNEL", "READ_INPUT_DEVICE_LIST", "READ_NETWORK_STATE",
    "READ_RUNNING_APPS", "READ_TV_CHANNEL_LIST", "READ_POWER_STATE", "READ_COUNTRY_INFO",
    "READ_SETTINGS", "READ_INSTALLED_APPS", "READ_LGE_SDX", "READ_NOTIFICATIONS",
    "READ_LGE_TV_INPUT_EVENTS", "READ_TV_CURRENT_TIME", "READ_UPDATE_INFO",
    "WRITE_NOTIFICATION_TOAST", "WRITE_NOTIFICATION_ALERT", "WRITE_SETTINGS",
    "SEARCH", "UPDATE_FROM_REMOTE_APP",
]


def die(msg):
    sys.exit(f"lgtv: {msg}")


def load_conf():
    try:
        return json.loads(CONFFILE.read_text())
    except Exception:
        return {}


def save_conf(conf):
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    CONFFILE.write_text(json.dumps(conf, indent=2) + "\n")


def migrate_old_key():
    old = pathlib.Path.home() / ".config" / "lgtv-client-key"
    if old.exists() and not KEYFILE.exists():
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        old.rename(KEYFILE)


def tv_host():
    if os.environ.get("LGTV_HOST"):
        return os.environ["LGTV_HOST"]
    try:
        out = subprocess.run(["avahi-resolve", "-4", "-n", MDNS_NAME],
                             capture_output=True, text=True, timeout=5, check=False).stdout.split()
        if len(out) > 1:
            return out[1]
    except Exception:
        pass
    host = load_conf().get("host")
    if not host:
        die(f"can't find the TV ({MDNS_NAME}); set LGTV_HOST")
    return host


def remember(host):
    """Store the TV's address and MAC (for Wake-on-LAN) after a successful connection."""
    conf = load_conf()
    conf["host"] = host
    try:
        m = re.search(r"lladdr ([0-9a-f:]{17})",
                      subprocess.run(["ip", "neigh", "show", host], capture_output=True, text=True, check=False).stdout)
        if m:
            conf["mac"] = m.group(1)
    except Exception:
        pass
    save_conf(conf)


def no_verify_ssl():
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx


class TV:
    def __init__(self, host=None, force_pair=False):
        self.host = host or tv_host()
        self.force_pair = force_pair
        self.ws = None
        self.n = 0

    async def __aenter__(self):
        import websockets
        try:
            self.ws = await websockets.connect(f"wss://{self.host}:3001", ssl=no_verify_ssl(),
                                               open_timeout=8, max_size=None)
        except (OSError, TimeoutError) as e:
            die(f"TV at {self.host} not reachable ({e}). Is it on? Try: lgtv on")
        await self._register()
        remember(self.host)
        return self

    async def __aexit__(self, *exc):
        await self.ws.close()

    async def _register(self):
        payload = {"forcePairing": False, "pairingType": "PROMPT",
                   "manifest": {"manifestVersion": 1, "appVersion": "1.1", "permissions": PERMISSIONS}}
        if KEYFILE.exists() and not self.force_pair:
            payload["client-key"] = KEYFILE.read_text().strip()
        await self.ws.send(json.dumps({"type": "register", "id": "register", "payload": payload}))
        while True:
            try:
                msg = json.loads(await asyncio.wait_for(self.ws.recv(), 120))
            except TimeoutError:
                die("pairing prompt not accepted on the TV (timed out)")
            if msg.get("type") == "registered":
                CONF_DIR.mkdir(parents=True, exist_ok=True)
                KEYFILE.write_text(msg["payload"]["client-key"])
                return
            if msg.get("type") == "error":
                die(f"pairing refused: {msg.get('error')}")
            if msg.get("payload", {}).get("pairingType") == "PROMPT":
                print("Accept the pairing prompt on the TV...", file=sys.stderr)

    async def call(self, uri, payload=None, check=True):
        self.n += 1
        mid = f"req{self.n}"
        msg = {"type": "request", "id": mid, "uri": uri}
        if payload is not None:
            msg["payload"] = payload
        await self.ws.send(json.dumps(msg))
        while True:
            resp = json.loads(await asyncio.wait_for(self.ws.recv(), 15))
            if resp.get("id") != mid:
                continue
            if check and (resp.get("type") == "error" or resp.get("payload", {}).get("returnValue") is False):
                raise RuntimeError(resp.get("error") or resp.get("payload", {}).get("errorText") or resp)
            return resp.get("payload", {})

    async def call_any(self, uris, payload=None):
        """Try several URIs (they differ between webOS versions); return the first that works."""
        err = None
        for uri in uris:
            try:
                return await self.call(uri, payload)
            except RuntimeError as e:
                err = e
        raise err

    async def buttons(self):
        """Open the pointer/button socket for remote-key presses."""
        import websockets
        path = (await self.call("ssap://com.webos.service.networkinput/getPointerInputSocket"))["socketPath"]
        if path.startswith("ws://"):  # newer firmware only serves TLS on 3001
            path = "wss://" + path[5:].replace(":3000/", ":3001/", 1)
        return await websockets.connect(path, ssl=no_verify_ssl() if path.startswith("wss") else None)


async def press(sock, name):
    await sock.send(f"type:button\nname:{name}\n\n")


async def move(sock, dx, dy):
    await sock.send(f"type:move\ndx:{dx}\ndy:{dy}\ndown:0\n\n")


async def click(sock):
    await sock.send("type:click\n\n")


async def scroll(sock, dy):
    await sock.send(f"type:scroll\ndx:0\ndy:{dy}\n\n")


NO_KEYBOARD = ("the TV's system keyboard isn't open. Apps like Plex, YouTube, Prime Video and Shahid draw "
               "their own letter grid, which only takes arrow keys; typing reaches the grey "
               "webOS keyboard (Web Browser, home search, some apps). For Plex, Prime Video "
               "and Shahid use: lgtv gridtype <text>; for YouTube: lgtv ytsearch / lgtv youtube.")


# ---------- typing on an app's own letter grid ----------
# Plex, Prime Video and Shahid draw their own keyboards, which only take arrow keys.
# We type on them as a person would: screenshot the TV, find the highlighted
# key, then walk the arrows to each letter and press OK. Positions are in the
# 960x540 screenshot; a grid is rows of 6 keys plus a bottom row of wide keys.

class Grid:
    def __init__(self, rows, xs, ys, bottom_y, bottom, ltr, half, key_bg, side_up=False, escapes=(),
                 clear_below=0, field=None):
        self.rows, self.xs, self.ys, self.ltr, self.half = rows, xs, ys, ltr, half
        self.by = bottom_y
        # bottom keys: (name, first col, last col, x). UP from one returns to the column
        # you came down from; we enter all but the space bar from their first column.
        # side_up: after arriving sideways, UP lands on the key's first column (Plex);
        # otherwise where it lands is unknown, so we step off the space bar first.
        self.bottom, self.side_up = bottom, side_up
        # keys off the grid we can step back from: (x, y, half, key to press)
        self.escapes = escapes
        # a Clear key this many DOWNs below backspace (Prime), when not on the bottom row
        self.clear_below = clear_below
        self.key_bg = key_bg  # a plain key's background shade (0-255), to recognise the grid
        # where the app shows what's been typed, (x0, y0, x1, y1): an OK is done when it changes
        self.field = field
        self.B = len(rows)  # the bottom row's index

    def find(self, ch):
        for r, row in enumerate(self.rows):
            if ch in row:
                return r, row.index(ch)
        return None

    def special(self, c):
        return next(i for i, b in enumerate(self.bottom) if b[1] <= c <= b[2])


LATIN = ["abcdef", "ghijkl", "mnopqr", "stuvwx", "yz1234", "567890"]
GRID_APPS = {
    "cdp-30": ("Plex", {
        "en": Grid(LATIN, [62, 98, 134, 170, 206, 242], [85, 121, 157, 193, 229, 265], 301,
                   [("bksp", 0, 1, 80), ("space", 2, 3, 152), ("clear", 4, 5, 224)], True, 11, 69,
                   side_up=True, field=(50, 28, 236, 60))}),
    "amazon": ("Prime Video", {
        "en": Grid(LATIN, [94, 127, 160, 193, 226, 259], [86, 119, 152, 185, 218, 251], 283,
                   [("space", 0, 3, 143), ("bksp", 4, 5, 242)], True, 10, 5,
                   escapes=[(114, 317, 10, "UP", "symbols"), (208, 317, 10, "UP", "accents"),
                            (178, 344, 6, "UP", "clear")], clear_below=2,
                   field=(78, 36, 286, 66))}),
    "net.mbc.shahid-lgapp": ("Shahid", {
        "ar": Grid(["ابتثجح", "خدذرزس", "شصضطظع", "غفقكلم", "نهويةئ", "ءؤ1234", "567890"],
                   [892, 855, 818, 781, 744, 707], [121, 158, 195, 232, 269, 306, 343], 380,
                   [("toggle", 0, 0, 892), ("space", 1, 4, 800), ("bksp", 5, 5, 707)], False, 12, 45),
        "en": Grid(LATIN, [707, 744, 781, 818, 855, 892], [121, 158, 195, 232, 269, 306], 343,
                   [("toggle", 0, 0, 707), ("space", 1, 4, 800), ("bksp", 5, 5, 892)], True, 12, 45)}),
}
ARABIC_FOLD = str.maketrans({"أ": "ا", "إ": "ا", "آ": "ا", "ى": "ي"})


def _lum(img, x, y):
    return sum(sum(img.getpixel((x + i, y + j))[:3]) / 3 for i in (-1, 0, 1) for j in (-1, 0, 1)) / 9


def _cell_bg(img, x, y, h):
    """A key's background brightness, sampled inside its corners (clear of the glyph)."""
    return sum(_lum(img, x + dx, y + dy) for dx in (-h, h) for dy in (-h, h)) / 4


def grid_locate(img, layouts):
    """Which layout is showing and where its highlight is: (name, (row, col)), or
    (name, ("via", KEY, key name)) on an extra key that KEY steps back from, or None."""
    # Of several layouts, the one whose bottom row is lowest and actually drawn
    for name, g in sorted(layouts.items(), key=lambda kv: -kv[1].by):
        if len(layouts) > 1 and max(_lum(img, b[3], g.by) for b in g.bottom) < 80:
            continue
        cells = [((r, c), x, y) for r, y in enumerate(g.ys) for c, x in enumerate(g.xs)]
        cells += [((g.B, b[1]), b[3], g.by) for b in g.bottom]
        scored = [(_cell_bg(img, x, y, g.half), pos) for pos, x, y in cells]
        scored += [(_cell_bg(img, x, y, h), ("via", k, n)) for x, y, h, k, n in g.escapes]
        scored.sort(key=lambda s: -s[0])  # by score alone: on a tie the positions don't compare
        if scored[0][0] >= 185 and scored[1][0] < 120:  # one white key among dark ones
            return name, scored[0][1]
        return None
    return None


def field_changed(a, b, box):
    """True if the typed text in box differs between screenshots a and b. A blinking
    caret changes a column or two; a letter typed or deleted, ten or more."""
    from PIL import ImageChops
    d = ImageChops.difference(a.convert("L").crop(box), b.convert("L").crop(box))
    w, h = d.size
    cols = sum(1 for x in range(w) if sum(d.getpixel((x, y)) > 60 for y in range(h)) >= 2)
    return cols >= 3


def grid_visible(img, layouts):
    """True if one of the layouts' letters are drawn, even with nothing highlighted on them:
    most keys show the app's plain key background with a bright letter on it."""
    gray = img.convert("L")
    for g in layouts.values():
        good = 0
        for y in g.ys:
            for x in g.xs:
                px = sorted(gray.getpixel((x + dx, y + dy)) for dx in range(-7, 8) for dy in range(-7, 8))
                good += abs(px[len(px) // 2] - g.key_bg) <= 15 and px[-1] > 140
        if good >= len(g.ys) * len(g.xs) * 0.8:
            return True
    return False


def grid_walk(g, pos, memo, target):
    """Arrow presses from pos to target (a (row, col) cell or a bottom key's name).

    memo is the column UP from a bottom key returns to, when known. Returns the
    presses, where they end, and the memo there."""
    r, c = pos
    keys = []

    def fwd(n):  # move n columns (negative: back)
        keys.extend([("RIGHT" if g.ltr else "LEFT") if n > 0 else ("LEFT" if g.ltr else "RIGHT")] * abs(n))

    def up_out():
        nonlocal r, c, memo
        i = g.special(c)
        if memo is None and g.side_up:
            memo = g.bottom[i][1]
        elif g.bottom[i][0] == "space" and memo is None:
            fwd(1)  # unsure where UP from the space bar lands: step off it first
            i += 1
        c = memo if memo is not None else g.bottom[i][1]
        keys.append("UP")
        r, memo = g.B - 1, None

    if isinstance(target, tuple):
        if r == g.B:
            up_out()
        tr, tc = target
        keys.extend(["DOWN" if tr > r else "UP"] * abs(tr - r))
        fwd(tc - c)
        return keys, target, None

    i = next(i for i, b in enumerate(g.bottom) if b[0] == target)
    lo, hi = g.bottom[i][1], g.bottom[i][2]
    if r == g.B:
        j = g.special(c)
        fwd(i - j)
        if i != j:
            memo = None
    else:
        # enter from a known column; all but the space bar from their first one
        col = min(max(c, lo), hi) if target == "space" else lo
        if r != g.B - 1 or c != col:
            keys.extend(["DOWN" if g.B - 1 > r else "UP"] * abs(g.B - 1 - r))
            fwd(col - c)
        keys.append("DOWN")
        memo = col
    return keys, (g.B, lo), memo


def grid_units(ops):
    """Split ops into single key presses: ("char", ch) | ("space",) | ("bksp", n)."""
    units = []
    for op, arg in ops:
        if op == "clear":
            units.append(("clear",))
            continue
        if op == "del":
            if arg > 0 and units and units[-1][0] == "bksp":  # one press after another
                units[-1] = ("bksp", units[-1][1] + arg)
            elif arg > 0:
                units.append(("bksp", arg))
            continue
        for ch in arg.lower().translate(ARABIC_FOLD):
            units.append(("space",) if ch.isspace() else ("char", ch))
    return units


async def tv_screenshot(call):
    """The TV's screen as a PIL image; call(uri) makes the request on the TV's socket."""
    from PIL import Image
    import io
    # A TV busy loading an app's artwork can time out one capture; the next usually works
    for attempt in (1, 2):
        try:
            uri = (await call("ssap://tv/executeOneShot"))["imageUri"]
            data = await asyncio.to_thread(
                lambda u=uri: urllib.request.urlopen(u, context=no_verify_ssl(), timeout=5).read())
            return Image.open(io.BytesIO(data)).convert("RGB")
        except (OSError, TimeoutError):
            if attempt == 2:
                raise
            await asyncio.sleep(0.5)


async def grid_type(call, sock, app, units, progress=lambda left: None):
    """Type units (from grid_units) on the app's letter grid, taking each off the list
    once it's typed: after an error, what's left is what didn't reach the TV.
    Returns an error message, or None. progress(n) hears how many are left.

    Before each OK it checks, on a fresh screenshot, that the intended key is
    highlighted, and walks again from wherever the highlight really is if not:
    an app busy loading results can drop or delay a press."""
    title, layouts = GRID_APPS[app]
    lost = f"open {title}'s search first: its letter grid isn't on the screen"

    # The search results sit beside the letters: left of them for a right-to-left app
    toward_grid = "LEFT" if next(iter(layouts.values())).ltr else "RIGHT"

    last = None  # the latest screenshot

    async def where(settle=0.25, expect=None):
        """Locate the highlight, stepping back onto the grid when it's in the results
        beside the letters or on a known extra key.

        Anywhere but expect is only believed once two screenshots agree: a busy app
        can show presses late, and re-planning from a stale highlight overshoots."""
        nonlocal last
        seen = None
        for _ in range(12):
            await asyncio.sleep(settle)  # let the highlight settle
            img = last = await tv_screenshot(call)
            found = grid_locate(img, layouts)
            if found and found[1][0] != "via":
                if expect is None or found in (expect, seen):
                    return found
                seen, settle = found, 0.35
                continue
            seen = None
            if found:
                await press(sock, found[1][1])
            elif grid_visible(img, layouts):
                await press(sock, toward_grid)
            else:
                return None
            settle = 0.4
        return None

    gap = 0.15  # between arrows; longer once the app is seen dropping them

    async def keys(ks):
        for k in ks:
            await press(sock, k)
            await asyncio.sleep(gap)

    async def ok(times, field):
        """Press OK; with field, wait after each for the typed text to change. The app
        freezes for a moment as it reloads its results, and drops arrows sent meanwhile.
        A press that shows no change isn't repeated: a thin letter can look unchanged,
        and pressing again would type it twice."""
        nonlocal last
        for _ in range(times):
            before = last if field else None
            if field and before is None:
                before = await tv_screenshot(call)
            await press(sock, "ENTER")
            if not field:
                await asyncio.sleep(0.15)
                continue
            deadline = time.monotonic() + 2.5
            while True:
                await asyncio.sleep(0.2)
                last = await tv_screenshot(call)
                if field_changed(before, last, field):
                    break
                if time.monotonic() > deadline:
                    field = None  # nothing to see (an empty box, say): stop waiting
                    break

    found = await where(0)
    if not found:
        return lost
    lname, pos = found
    memo, tries = None, 0
    while units:
        progress(len(units))
        unit, g, switch_to = units[0], layouts[lname], None
        if unit[0] == "char" and g.find(unit[1]) is None:
            switch_to = next((n for n, o in layouts.items() if o.find(unit[1])), None)
            if switch_to is None:
                units.pop(0)  # not on this keyboard
                continue
            target, presses = "toggle", 1
        elif unit[0] == "char":
            target, presses = g.find(unit[1]), 1
        elif unit[0] == "clear":
            if any(b[0] == "clear" for b in g.bottom):
                target, presses = "clear", 1
            elif g.clear_below:
                target, presses = "bksp", 0  # then step down to the Clear key
            else:
                target, presses = "bksp", 30  # no Clear key: delete more than a search holds
        else:
            target, presses = unit[0], unit[1] if unit[0] == "bksp" else 1

        moves, expect, new_memo = grid_walk(g, pos, memo, target)
        await keys(moves)
        if moves:
            found = await where(expect=(lname, expect))
            if not found:
                return lost
            if found != (lname, expect):  # re-plan from where the highlight really is
                lname, pos, memo = found[0], found[1], None
                tries += 1
                gap = min(0.6, gap * 2)  # presses went missing: the app is busy, go slower
                if tries > 6:
                    return f"the highlight on {title}'s letters keeps landing somewhere unexpected; try again"
                continue
        tries = 0
        if unit[0] == "clear" and presses == 0:
            await keys(["DOWN"] * g.clear_below)
            await asyncio.sleep(0.25)
            hit = grid_locate(await tv_screenshot(call), layouts)
            if hit and hit[1][0] == "via" and hit[1][2] == "clear":
                await ok(1, g.field)
                units.pop(0)
            else:
                units[0] = ("bksp", 30)  # didn't find it: delete instead
            found = await where()
            if not found:
                return lost
            lname, pos, memo = found[0], found[1], None
            continue
        # A space can't be seen at the end of the text, and the layout toggle types nothing
        watch = g.field if unit[0] in ("char", "bksp", "clear") and not switch_to else None
        await ok(presses, watch)
        if switch_to:  # the other layout opens on its first key; type the letter there next
            lname, pos, memo = switch_to, (0, 0), None
        else:
            pos, memo = expect, new_memo
            units.pop(0)
    progress(0)
    return None


async def foreground_app(tv):
    return (await tv.call("ssap://com.webos.applicationManager/getForegroundAppInfo")).get("appId", "")


async def cmd_gridtype(tv, args):
    if not args:
        die("usage: lgtv gridtype [--replace] <text>   (Plex, Prime Video or Shahid, search open)")
    replace = args[0] == "--replace"
    if replace:
        args = args[1:]
    app = await foreground_app(tv)
    if app not in GRID_APPS:
        die(f"the app on screen ({app or 'none'}) isn't one whose letter grid I know: "
            + ", ".join(t for t, _ in GRID_APPS.values()))
    sock = await tv.buttons()
    try:
        ops = ([("clear", None)] if replace else []) + [("text", " ".join(args))]
        err = await grid_type(lambda uri: tv.call(uri), sock, app, grid_units(ops))
    finally:
        await sock.close()
    if err:
        die(err)


async def tv_keyboard_open(tv):
    """True if the webOS system keyboard has focus right now."""
    await tv.ws.send(json.dumps({"type": "subscribe", "id": "kbdcheck",
                                 "uri": "ssap://com.webos.service.ime/registerRemoteKeyboard"}))
    try:
        while True:
            msg = json.loads(await asyncio.wait_for(tv.ws.recv(), 0.8))
            widget = msg.get("payload", {}).get("currentWidget") if msg.get("id") == "kbdcheck" else None
            if isinstance(widget, dict) and "focus" in widget:
                return bool(widget["focus"])
    except TimeoutError:
        return False


# ---------- commands ----------

async def cmd_status(tv, args):
    try:
        p = await tv.call("ssap://com.webos.service.tvpower/power/getPowerState")
        print("power:  ", p.get("state", "?"))
    except RuntimeError:
        pass
    app = await tv.call("ssap://com.webos.applicationManager/getForegroundAppInfo")
    print("app:    ", app.get("appId") or "?")
    await cmd_vol(tv, [])


async def cmd_vol(tv, args):
    if not args:
        v = await tv.call("ssap://audio/getVolume")
        st = v.get("volumeStatus", v)
        muted = st.get("muteStatus", st.get("muted", False))
        print("volume: ", st.get("volume", "?"), "(muted)" if muted else "")
    elif args[0] in ("up", "+"):
        await tv.call("ssap://audio/volumeUp")
    elif args[0] in ("down", "-"):
        await tv.call("ssap://audio/volumeDown")
    elif args[0].isdigit():
        await tv.call("ssap://audio/setVolume", {"volume": max(0, min(100, int(args[0])))})
    else:
        die("usage: lgtv vol [N|up|down]")


async def cmd_mute(tv, args, on=True):
    await tv.call("ssap://audio/setMute", {"mute": on})


async def cmd_off(tv, args):
    await tv.call("ssap://system/turnOff")


async def cmd_screen(tv, args):
    if not args or args[0] not in ("on", "off"):
        die("usage: lgtv screen off|on")
    verb = "turnOffScreen" if args[0] == "off" else "turnOnScreen"
    await tv.call_any([f"ssap://com.webos.service.tvpower/power/{verb}",
                       f"ssap://com.webos.service.tv.power/{verb}"], {"standbyMode": "active"})


MEDIA = {"play": "play", "pause": "pause", "stop": "stop", "ff": "fastForward", "rew": "rewind"}


async def cmd_media(tv, args, action):
    await tv.call(f"ssap://media.controls/{MEDIA[action]}")


async def cmd_input(tv, args):
    devices = (await tv.call("ssap://tv/getExternalInputList")).get("devices", [])
    if not args:
        for d in devices:
            mark = "" if d.get("connected") else "   (nothing connected)"
            print(f"{d['id']:<12} {d.get('label', '')}{mark}")
        return
    q = args[0]
    want = f"HDMI_{q}" if q.isdigit() else q
    for d in devices:
        if d["id"].lower() == want.lower() or q.lower() in d.get("label", "").lower():
            await tv.call("ssap://tv/switchInput", {"inputId": d["id"]})
            print(f"switched to {d['id']} ({d.get('label', '')})")
            return
    die(f"no input matching {q!r}; see: lgtv input")


async def list_apps(tv):
    lps = (await tv.call("ssap://com.webos.applicationManager/listLaunchPoints")).get("launchPoints", [])
    return sorted(((lp["id"], lp.get("title", "")) for lp in lps), key=lambda a: a[1].lower())


async def cmd_apps(tv, args):
    for aid, title in await list_apps(tv):
        print(f"{title:<28} {aid}")


async def cmd_app(tv, args):
    if not args:
        return await cmd_apps(tv, args)
    q = " ".join(args).lower()
    apps = await list_apps(tv)
    match = ([a for a in apps if a[0].lower() == q or a[1].lower() == q]
             or [a for a in apps if q in a[1].lower() or q in a[0].lower()])
    if not match:
        die(f"no app matching {q!r}; see: lgtv apps")
    await tv.call("ssap://system.launcher/launch", {"id": match[0][0]})
    print(f"launched {match[0][1]}")


async def cmd_open(tv, args):
    if len(args) != 1:
        die("usage: lgtv open <url>")
    await tv.call("ssap://system.launcher/open", {"target": args[0]})


def youtube_id(s):
    m = re.search(r"(?:v=|youtu\.be/|/shorts/|/embed/|/live/)([\w-]{11})", s)
    if m:
        return m.group(1)
    if re.fullmatch(r"[\w-]{11}", s):
        return s
    die(f"can't find a YouTube video id in {s!r}")


# The YouTube app ignores video ids passed at launch now, so play the way a
# phone's cast button does: DIAL (the TV's port 36866) starts the app and names
# its screen, and YouTube's lounge service tells that screen what to play.
DIAL_PORT = 36866
YT_ORIGIN = {"Origin": "https://www.youtube.com"}
LOUNGE = "https://www.youtube.com/api/lounge"
YOUTUBE_APP = "youtube.leanback.v4"


def http(url, data=None, headers=None, timeout=10):
    body = urllib.parse.urlencode(data).encode() if isinstance(data, dict) else data
    req = urllib.request.Request(url, data=body, headers=headers or {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode(errors="ignore")


def dial_youtube(host):
    """The YouTube app's DIAL state ("running", "stopped", ...) and its lounge screen id."""
    xml = http(f"http://{host}:{DIAL_PORT}/apps/YouTube", headers=YT_ORIGIN, timeout=5)
    m = re.search(r"<screenId>([^<]+)</screenId>", xml)
    return re.search(r"<state>([^<]*)</state>", xml).group(1), m and m.group(1)


def youtube_screen(host):
    """Start the YouTube app if needed; return its lounge screen id."""
    try:
        st, screen = dial_youtube(host)
        if st != "running":
            http(f"http://{host}:{DIAL_PORT}/apps/YouTube", b"", headers=YT_ORIGIN, timeout=5)
            for _ in range(30):
                time.sleep(1)
                st, screen = dial_youtube(host)
                if st == "running" and screen:
                    break
            time.sleep(5)  # let the app reach YouTube before it's told what to play
    except (OSError, AttributeError) as e:
        die(f"can't reach the TV's YouTube app over DIAL ({e}); is the TV on?")
    if not screen:
        die("the TV's YouTube app didn't give a screen id")
    return screen


def lounge_events(lines):
    """The events in a lounge reply, as (number, name, data). A reply is pieces of
    "<length>\\n<json list>", a list spread over several lines; a piece is taken as
    whole once it parses, so it doesn't matter how the length counts non-ASCII text."""
    piece = None
    for line in lines:
        line = line.rstrip("\r\n")
        if piece is None:
            if line.isdigit():
                piece = []
            continue
        piece.append(line)
        if not line.endswith("]"):
            continue
        try:
            events = json.loads("\n".join(piece))
        except ValueError:
            continue
        piece = None
        for n, ev in events:
            yield n, ev[0], ev[1] if len(ev) > 1 else None


def lounge_bind(screen, capabilities, device=None):
    """Link to a YouTube screen as a remote control. Returns the parameters every
    request on the link carries, and the events it opens with."""
    tok = json.loads(http(f"{LOUNGE}/pairing/get_lounge_token_batch", {"screen_ids": screen}))
    q = {"device": "REMOTE_CONTROL", "id": device or str(uuid.uuid4()), "name": "lgtv", "app": "youtube-desktop",
         "mdx-version": "3", "loungeIdToken": tok["screens"][0]["loungeToken"], "VER": "8", "v": "2",
         "theme": "cl", "capabilities": capabilities, "ui": "", "TYPE": "", "CVER": "1", "zx": "x", "t": "1"}
    raw = http(f"{LOUNGE}/bc/bind?" + urllib.parse.urlencode({**q, "RID": "1"}), {"count": "0"})
    events = list(lounge_events(raw.splitlines()))
    ids = {name: data for _, name, data in events}
    q.update(SID=ids["c"], gsessionid=ids["S"])
    return q, events


def lounge_send(q, n, aid, command, **args):
    """Send a link's nth command (from 0); aid is the last event received on it."""
    http(f"{LOUNGE}/bc/bind?" + urllib.parse.urlencode({**q, "RID": str(n + 2), "AID": str(aid)}),
         {"count": "1", "ofs": str(n), "req0__sc": command, **{f"req0_{k}": v for k, v in args.items()}})


def cmd_youtube(args):
    if len(args) != 1:
        die("usage: lgtv youtube <url|id>")
    vid = youtube_id(args[0])
    screen = youtube_screen(tv_host())
    try:
        q, _ = lounge_bind(screen, "que,dsdtr,atp")
        lounge_send(q, 0, 5, "setPlaylist", videoId=vid, currentTime="0", currentIndex="0",
                    videoIds=vid, listId="", audioOnly="false")
    except (OSError, KeyError, IndexError, ValueError, AttributeError) as e:
        die(f"YouTube's lounge service refused the video ({e})")


# ---------- what the YouTube app is playing ----------
# The TV doesn't say how far into a video an app is. YouTube's lounge does, to
# anything linked as a remote: the video, its length, and the position at each
# play, pause and seek. It takes seeks back, too.

YT_STATES = {"1": "playing", "2": "paused", "3": "buffering", "1081": "ad"}


def youtube_title(vid):
    """A video's title and channel, from YouTube's oEmbed; empty when it won't say."""
    try:
        d = json.loads(http("https://www.youtube.com/oembed?" + urllib.parse.urlencode(
            {"format": "json", "url": f"https://www.youtube.com/watch?v={vid}"}), timeout=8))
        return str(d.get("title") or "").strip(), str(d.get("author_name") or "").strip()
    except (OSError, ValueError, AttributeError):
        return "", ""


class YouTubeLink(threading.Thread):
    """A standing link to the TV's YouTube app that only watches and seeks. A thread,
    since the lounge's event stream is one long blocking read; each event goes to
    on_event(link, name, data).

    It claims no capabilities. A remote that says it handles autoplay ("atp", as the
    one playing a video does) takes autoplay over from the TV for as long as it's
    linked; to this one the TV reports autoplay as none of its business.
    """

    def __init__(self, host, on_event):
        super().__init__(daemon=True)
        self.host, self.on_event = host, on_event
        # One id per machine, so linking again replaces the last link instead of
        # leaving the TV with another remote.
        self.device = str(uuid.uuid5(uuid.NAMESPACE_DNS, socket.gethostname() + ".lgtv"))
        self.gone = False  # set to stop following
        self.q = None      # the link's request parameters, while there is one
        self.aid = 0       # the last event received
        self.sent = 0      # commands sent on this link
        self.lock = threading.Lock()

    def run(self):
        wait = 5
        while not self.gone:
            began = time.monotonic()
            try:
                self.follow()
            except (OSError, ValueError, KeyError, IndexError, AttributeError, TypeError):
                pass
            self.q = None
            # The app may still be starting, or YouTube dropped the link. Each new link
            # shows a notice on the TV, so one that keeps failing is retried ever less often.
            if time.monotonic() - began > 60:
                wait = 5
            time.sleep(wait)
            wait = min(wait * 2, 300)

    def follow(self):
        st, screen = dial_youtube(self.host)
        if st != "running" or not screen:
            return
        q, events = lounge_bind(screen, "", self.device)
        with self.lock:
            self.q, self.sent = q, 0

        def take(events):
            for n, name, data in events:
                self.aid = n
                if not self.gone:
                    self.on_event(self, name, data)

        take(events)
        while not self.gone:
            began = time.monotonic()
            url = f"{LOUNGE}/bc/bind?" + urllib.parse.urlencode(
                {**q, "RID": "rpc", "AID": str(self.aid), "CI": "0", "TYPE": "xmlhttp"})
            try:
                with urllib.request.urlopen(url, timeout=120) as r:
                    take(lounge_events(line.decode(errors="ignore") for line in r))
            except TimeoutError:
                continue  # nothing for two minutes (a paused video): listen again
            # YouTube ends a stream every so often, and the next picks up where it
            # stopped. One that ends at once means the link itself is gone.
            if time.monotonic() - began < 2:
                return

    def send(self, command, **args):
        """Send the app a command; False if there's no link or YouTube refused it."""
        with self.lock:  # one at a time: each command says which one of the link's it is
            if not self.q:
                return False
            try:
                lounge_send(self.q, self.sent, self.aid, command, **args)
            except OSError:
                return False
            self.sent += 1
            return True


def cmd_ytsearch(args):
    if not args:
        die("usage: lgtv ytsearch <query>")
    r = subprocess.run(["yt-dlp", "--flat-playlist", "-J", "--no-warnings", "ytsearch15:" + " ".join(args)],
                       capture_output=True, text=True, timeout=60, check=False)
    if r.returncode != 0:
        die((r.stderr.strip().splitlines() or ["yt-dlp failed"])[-1])
    for e in json.loads(r.stdout).get("entries", []):
        if e.get("id"):
            print(json.dumps({"id": e["id"], "title": e.get("title") or "", "channel": e.get("channel") or "",
                              "duration": e.get("duration"), "live": e.get("live_status") == "is_live",
                              "views": e.get("view_count")}, ensure_ascii=False))


async def cmd_notify(tv, args):
    if not args:
        die("usage: lgtv notify <message>")
    await tv.call("ssap://system.notifications/createToast", {"message": " ".join(args)})


async def cmd_key(tv, args):
    if not args:
        die("usage: lgtv key UP|DOWN|LEFT|RIGHT|ENTER|BACK|HOME|EXIT|MENU|INFO|VOLUMEUP|... (several allowed)")
    sock = await tv.buttons()
    try:
        for k in args:
            await press(sock, k.upper())
            await asyncio.sleep(0.15)
    finally:
        await sock.close()


async def cmd_type(tv, args):
    enter = "--enter" in args
    text = " ".join(a for a in args if a != "--enter")
    if not text and not enter:
        die("usage: lgtv type [--enter] <text>   (with the TV's keyboard open)")
    if not await tv_keyboard_open(tv):
        print(f"lgtv: warning: {NO_KEYBOARD}", file=sys.stderr)
    if text:
        await tv.call("ssap://com.webos.service.ime/insertText", {"text": text, "replace": 0})
    if enter:
        await tv.call("ssap://com.webos.service.ime/sendEnterKey")


REMOTE_HELP = """remote: arrows move · Enter OK · Backspace back · h home · i info · s settings
        + / - volume · m mute · space pause · p play · Tab typing · c mouse · q quit
        Typing: when the TV shows its system keyboard, typing goes to it; Esc or Tab
        returns to remote keys. (Plex/YouTube/Prime/Shahid grids take arrow keys only.)
        Mouse: arrows move the pointer (Shift = faster), Enter/space click,
        PgUp/PgDn scroll, Backspace back, Esc or c returns. Ctrl-C quits."""
REMOTE_KEYS = {"\x1b[A": "UP", "\x1b[B": "DOWN", "\x1b[C": "RIGHT", "\x1b[D": "LEFT",
               "\r": "ENTER", "\n": "ENTER", "\x7f": "BACK", "\x08": "BACK", "h": "HOME",
               "i": "INFO", "s": "MENU", "+": "VOLUMEUP", "=": "VOLUMEUP", "-": "VOLUMEDOWN",
               "m": "MUTE", " ": "PAUSE", "p": "PLAY"}
ARROWS = {k: v for k, v in REMOTE_KEYS.items() if k.startswith("\x1b[")}
# Mouse mode: escape sequences -> (dx, dy). Shift+arrow (\x1b[1;2X) moves further.
MOUSE_STEP, MOUSE_FAST = 30, 120
MOUSE_DIRS = {"A": (0, -1), "B": (0, 1), "C": (1, 0), "D": (-1, 0)}
MOUSE_TOKENS = re.compile(r"\x1b\[1;2([ABCD])|\x1b\[([ABCD])|\x1b\[([56])~|\x1b|.", re.S)


async def cmd_remote(tv, args):
    import termios
    import tty
    if not sys.stdin.isatty():
        die("remote needs a terminal")
    print(REMOTE_HELP)
    sock = await tv.buttons()
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    loop = asyncio.get_running_loop()
    state = {"typing": False, "tv_keyboard": False, "mouse": False}

    def show(msg):
        sys.stdout.write(f"\r\x1b[K{msg}")
        sys.stdout.flush()

    def mode_line():
        if state["mouse"]:
            show("🖱  mouse  (arrows move, Shift faster, Enter click, PgUp/PgDn scroll, Esc/c: remote keys)")
        elif state["typing"] and state["tv_keyboard"]:
            show("⌨  typing on the TV  (Esc/Tab: remote keys)")
        elif state["typing"]:
            show("⌨  typing, but no TV system keyboard is open (Plex/YouTube grids: use arrows)")
        else:
            show("🎮 remote keys")

    async def mouse_input(s):
        """Handle a chunk of input in mouse mode; held keys arrive as several sequences."""
        dx = dy = 0
        for m in MOUSE_TOKENS.finditer(s):
            fast, arrow, page = m.group(1), m.group(2), m.group(3)
            tok = m.group(0)
            if fast or arrow:
                ux, uy = MOUSE_DIRS[fast or arrow]
                step = MOUSE_FAST if fast else MOUSE_STEP
                dx, dy = dx + ux * step, dy + uy * step
                continue
            if dx or dy:
                await move(sock, dx, dy)
                dx = dy = 0
            if page:
                await scroll(sock, -3 if page == "5" else 3)
            elif tok in ("\r", "\n", " "):
                await click(sock)
            elif tok in ("\x7f", "\x08"):
                await press(sock, "BACK")
            elif tok in ("\x1b", "c"):
                state["mouse"] = False
                mode_line()
                return
            elif tok == "h":
                await press(sock, "HOME")
        if dx or dy:
            await move(sock, dx, dy)

    # From here on only reader() reads the main socket; requests are sent without waiting.
    n = 0

    async def send(uri, payload=None):
        nonlocal n
        n += 1
        msg = {"type": "request", "id": f"rk{n}", "uri": uri}
        if payload is not None:
            msg["payload"] = payload
        await tv.ws.send(json.dumps(msg))

    async def reader():
        """Follow the TV's keyboard: typing mode switches on when it opens, off when it closes."""
        async for raw in tv.ws:
            try:
                msg = json.loads(raw)
            except ValueError:
                continue
            if msg.get("id") != "kbd":
                continue
            widget = msg.get("payload", {}).get("currentWidget")
            if not isinstance(widget, dict) or "focus" not in widget:
                continue
            focus = bool(widget["focus"])
            if focus != state["tv_keyboard"]:
                state["tv_keyboard"] = state["typing"] = focus
                if not state["mouse"]:
                    mode_line()

    await tv.ws.send(json.dumps({"type": "subscribe", "id": "kbd",
                                 "uri": "ssap://com.webos.service.ime/registerRemoteKeyboard"}))
    watch = asyncio.create_task(reader())
    try:
        tty.setraw(fd)
        mode_line()
        while True:
            s = (await loop.run_in_executor(None, os.read, fd, 1024)).decode(errors="ignore")
            if not s or s in ("\x03", "\x04"):
                break
            if state["mouse"]:
                await mouse_input(s)
            elif s == "\t":
                state["typing"] = not state["typing"]
                mode_line()
            elif state["typing"]:
                if s == "\x1b":
                    state["typing"] = False
                    mode_line()
                elif s in ARROWS:
                    await press(sock, ARROWS[s])
                elif s in ("\r", "\n"):
                    await send("ssap://com.webos.service.ime/sendEnterKey")
                elif s in ("\x7f", "\x08"):
                    await send("ssap://com.webos.service.ime/deleteCharacters", {"count": 1})
                elif s.isprintable():  # one key, or a whole pasted string
                    await send("ssap://com.webos.service.ime/insertText", {"text": s, "replace": 0})
            elif s == "q":
                break
            elif s == "c":
                state["mouse"] = True
                mode_line()
                await move(sock, 0, 0)  # wakes the pointer so it shows up
            elif s in REMOTE_KEYS:
                await press(sock, REMOTE_KEYS[s])
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        watch.cancel()
        await sock.close()
        print()


async def cmd_pipe(tv, args):
    """Read commands from stdin, one per line; report the TV keyboard on stdout as JSON."""
    sock = await tv.buttons()
    loop = asyncio.get_running_loop()
    reader = asyncio.StreamReader()
    await loop.connect_read_pipe(lambda: asyncio.StreamReaderProtocol(reader), sys.stdin)
    n = 0

    def emit(**kw):
        print(json.dumps(kw), flush=True)

    async def send(uri, payload=None):
        nonlocal n
        n += 1
        msg = {"type": "request", "id": f"p{n}", "uri": uri}
        if payload is not None:
            msg["payload"] = payload
        await tv.ws.send(json.dumps(msg))

    waiting = {}  # request id -> future, for the replies we wait on
    state = {"keyboard": False, "app": "", "power": ""}

    async def call(uri, payload=None):
        nonlocal n
        n += 1
        fut = waiting[f"w{n}"] = loop.create_future()
        msg = {"type": "request", "id": f"w{n}", "uri": uri}
        if payload is not None:
            msg["payload"] = payload
        await tv.ws.send(json.dumps(msg))
        try:
            return await asyncio.wait_for(fut, 10)
        finally:
            waiting.pop(f"w{n}", None)

    async def watch():
        async for raw in tv.ws:
            try:
                msg = json.loads(raw)
            except ValueError:
                continue
            mid, payload = msg.get("id"), msg.get("payload", {})
            if mid in waiting:
                waiting[mid].set_result(payload)
            elif mid == "kbd":
                widget = payload.get("currentWidget")
                if isinstance(widget, dict) and "focus" in widget and bool(widget["focus"]) != state["keyboard"]:
                    state["keyboard"] = bool(widget["focus"])
                    emit(keyboard=state["keyboard"])
            elif mid == "pw" and payload.get("state") and payload["state"] != state["power"]:
                # "Active" when on; with Quick Start+ an "off" TV still answers, as
                # "Active Standby", "Suspend" or "Screen Off", and ignores the remote
                state["power"] = payload["state"]
                emit(power=state["power"])
            elif mid == "fg" and "appId" in payload and payload["appId"] != state["app"]:
                state["app"] = payload["appId"]
                emit(app=state["app"], grid=GRID_APPS.get(state["app"], ("",))[0])
                yt_follow(state["app"] == YOUTUBE_APP)

    # What YouTube is playing, for a playbar. Its reports come at each play, pause
    # and seek; in between, the position is counted on from the last one.
    yt = {"link": None, "ticker": None, "id": "", "title": "", "channel": "", "state": "",
          "position": 0.0, "duration": 0.0, "rate": 1.0, "at": 0.0,
          "reported": False}  # the position is YouTube's word, not where a seek was sent
    said = {"playing": None}
    jobs = set()  # asyncio only holds tasks weakly: keep them until they're done

    def spawn(coro):
        task = asyncio.create_task(coro)
        jobs.add(task)
        task.add_done_callback(jobs.discard)

    def yt_position():
        moved = (time.monotonic() - yt["at"]) * yt["rate"] if yt["state"] == "playing" else 0
        return max(0.0, min(yt["position"] + moved, yt["duration"] or float("inf")))

    def say_playing():
        now = None
        if yt["link"] and yt["id"] and yt["state"]:
            now = {"app": "YouTube", "id": yt["id"], "title": yt["title"], "channel": yt["channel"],
                   "state": yt["state"], "position": int(yt_position()), "duration": int(yt["duration"])}
        if now != said["playing"]:
            said["playing"] = now
            emit(playing=now)

    async def yt_title(link, vid):
        title, channel = await asyncio.to_thread(youtube_title, vid)
        if link is yt["link"] and vid == yt["id"]:
            yt.update(title=title, channel=channel)
            say_playing()

    def yt_event(link, name, data):
        if link is not yt["link"] or name not in ("nowPlaying", "onStateChange") or not isinstance(data, dict):
            return  # from a link since dropped, or not about playback

        def num(key):
            try:
                return float(data.get(key) or 0)
            except ValueError:
                return 0.0

        if name == "nowPlaying" and data.get("videoId", "") != yt["id"]:
            yt.update(id=data.get("videoId", ""), title="", channel="", state="", duration=0.0)
            if yt["id"]:
                spawn(yt_title(link, yt["id"]))
        state_now, position, at = YT_STATES.get(data.get("state"), ""), num("currentTime"), time.monotonic()
        # Two reports from one stretch of playing tell the speed it's playing at
        if (yt["reported"] and state_now == yt["state"] == "playing"
                and at - yt["at"] > 15 and position > yt["position"]):
            rate = round((position - yt["position"]) / (at - yt["at"]) * 20) / 20
            if 0.25 <= rate <= 3:
                yt["rate"] = rate
        yt.update(state=state_now, position=position, duration=num("duration") or yt["duration"],
                  at=at, reported=True)
        say_playing()

    async def yt_tick(link):
        """Say where the video is each second it plays. Every half minute ask YouTube
        where it really is: that corrects the count, and gives the playing speed."""
        n = 0
        while True:
            await asyncio.sleep(1)
            say_playing()
            n += 1
            if n % 30 == 0 and yt["state"] == "playing":
                spawn(asyncio.to_thread(link.send, "getNowPlaying"))

    def from_link(*event):
        try:
            loop.call_soon_threadsafe(yt_event, *event)
        except RuntimeError:
            pass  # the pipe is closing

    def yt_follow(on):
        """Keep a link to the YouTube app while it's the app on screen."""
        if on == bool(yt["link"]):
            return
        if yt["link"]:
            yt["link"].gone = True
            yt["ticker"].cancel()
        yt.update(link=None, ticker=None, id="", state="")
        if on:
            yt["link"] = YouTubeLink(tv.host, from_link)
            yt["link"].start()
            yt["ticker"] = asyncio.create_task(yt_tick(yt["link"]))
        say_playing()

    async def grid(first):
        """Type on the app's letter grid: gather what follows within a moment, walk once."""
        ops, pushback = [first], None
        while True:
            try:
                nxt = await asyncio.wait_for(reader.readline(), 0.35)
            except TimeoutError:
                break
            c, _, a = nxt.decode(errors="ignore").rstrip("\n").partition(" ")
            if c == "text" and a:
                ops.append(("text", a))
            elif c == "del":
                ops.append(("del", int(a or 1)))
            else:
                pushback = nxt
                break
        # A busy TV can miss a screenshot or lose the highlight for a moment: try what's
        # left again rather than let the TV fall behind the box without a word
        units = grid_units(ops)
        for _attempt in range(3):
            try:
                err = await grid_type(call, sock, state["app"], units,
                                      lambda left: emit(grid_left=left))
            except (OSError, TimeoutError, KeyError, ValueError) as e:
                err = f"couldn't read the TV's screen ({e})"
            if not err or not units:
                break
            await asyncio.sleep(1.5)
        if err:
            emit(grid_left=0, grid_error=f"{err} ({len(units)} typed in the box didn't reach the TV)")
        else:
            emit(grid_error="")
        return pushback

    await tv.ws.send(json.dumps({"type": "subscribe", "id": "kbd",
                                 "uri": "ssap://com.webos.service.ime/registerRemoteKeyboard"}))
    await tv.ws.send(json.dumps({"type": "subscribe", "id": "fg",
                                 "uri": "ssap://com.webos.applicationManager/getForegroundAppInfo"}))
    await tv.ws.send(json.dumps({"type": "subscribe", "id": "pw",
                                 "uri": "ssap://com.webos.service.tvpower/power/getPowerState"}))
    watcher = asyncio.create_task(watch())
    emit(ready=True, keyboard=False)
    pending = None
    try:
        while True:
            line, pending = pending or await reader.readline(), None
            if not line:
                break
            cmd, _, rest = line.decode(errors="ignore").rstrip("\n").partition(" ")
            on_grid = not state["keyboard"] and state["app"] in GRID_APPS
            try:
                if on_grid and cmd == "text" and rest:
                    pending = await grid(("text", rest))
                elif on_grid and cmd == "del":
                    pending = await grid(("del", int(rest or 1)))
                elif on_grid and cmd == "enter":
                    pass  # these apps search as you type
                elif cmd == "key" and rest:
                    await press(sock, rest.strip().upper())
                elif cmd == "move":
                    dx, dy = (int(float(v)) for v in rest.split()[:2])
                    await move(sock, dx, dy)
                elif cmd == "click":
                    await click(sock)
                elif cmd == "scroll":
                    await scroll(sock, int(float(rest or 0)))
                elif cmd == "text" and rest:
                    await send("ssap://com.webos.service.ime/insertText", {"text": rest, "replace": 0})
                elif cmd == "enter":
                    await send("ssap://com.webos.service.ime/sendEnterKey")
                elif cmd == "del":
                    await send("ssap://com.webos.service.ime/deleteCharacters", {"count": int(rest or 1)})
                elif cmd == "wake" and state["power"] == "Screen Off":
                    await send("ssap://com.webos.service.tvpower/power/turnOnScreen", {"standbyMode": "active"})
                elif cmd == "seek" and yt["link"] and yt["duration"]:
                    secs = max(0.0, min(float(rest), yt["duration"]))
                    # Count on from there at once; the TV's own report follows in a second or two
                    yt.update(position=secs, at=time.monotonic(), reported=False)
                    say_playing()
                    spawn(asyncio.to_thread(yt["link"].send, "seekTo", newTime=str(int(secs))))
            except ValueError:
                pass
            if watcher.done():
                break  # the TV went away
    finally:
        watcher.cancel()
        if yt["link"]:
            yt["link"].gone = True
        await sock.close()


async def cmd_pair(tv, args):
    print("paired.")


# ---------- no websocket needed ----------

def cmd_on(args):
    mac = load_conf().get("mac")
    if not mac:
        die("no MAC address saved yet; run any lgtv command once while the TV is on")
    packet = b"\xff" * 6 + bytes.fromhex(mac.replace(":", "")) * 16
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    host = load_conf().get("host", "")
    targets = {"255.255.255.255"}
    if host.count(".") == 3:
        targets.add(host.rsplit(".", 1)[0] + ".255")
    for t in targets:
        for port in (9, 7):
            s.sendto(packet, (t, port))
    print("wake packet sent (needs TV setting: General > Devices > TV Management/Mobile TV On > Turn on via Wi-Fi)")


def cmd_cast(args):
    if not args:
        die("usage: lgtv cast <file|dir|url>...   (see: cast --help)")
    os.execvp("cast", ["cast", "play", *args])


COMMANDS = {
    "status": cmd_status, "vol": cmd_vol, "volume": cmd_vol,
    "mute": lambda tv, a: cmd_mute(tv, a, True), "unmute": lambda tv, a: cmd_mute(tv, a, False),
    "off": cmd_off, "screen": cmd_screen, "input": cmd_input, "hdmi": cmd_input,
    "apps": cmd_apps, "app": cmd_app, "open": cmd_open,
    "notify": cmd_notify, "key": cmd_key, "type": cmd_type, "gridtype": cmd_gridtype,
    "remote": cmd_remote, "pipe": cmd_pipe, "pair": cmd_pair,
    **{m: (lambda tv, a, action=m: cmd_media(tv, a, action)) for m in MEDIA},
}


async def run(cmd, args):
    async with TV(force_pair=(cmd == "pair")) as tv:
        try:
            await COMMANDS[cmd](tv, args)
        except RuntimeError as e:
            die(f"{cmd} failed: {e}")


def main():
    migrate_old_key()
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, args = argv[0], argv[1:]
    if cmd == "on":
        return cmd_on(args)
    if cmd == "cast":
        return cmd_cast(args)
    if cmd in ("youtube", "yt"):
        return cmd_youtube(args)
    if cmd == "ytsearch":
        return cmd_ytsearch(args)
    if cmd == "host":
        return print(tv_host())
    if cmd not in COMMANDS:
        die(f"unknown command {cmd!r}; see: lgtv --help")
    asyncio.run(run(cmd, args))


if __name__ == "__main__":
    main()
