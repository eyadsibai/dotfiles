#!/usr/bin/env -S uv run -q --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["websockets>=13", "pillow"]
# ///
"""lgtv — control the LG webOS TV from this machine.

  lgtv status                 power state, foreground app, volume
  lgtv on | off               power on (Wake-on-LAN) / off
  lgtv screen off|on          blank the panel, keep sound (and back)
  lgtv vol [N|up|down]        show or set volume
  lgtv mute | unmute
  lgtv play|pause|stop|ff|rew media controls
  lgtv input [N|name]         list inputs, or switch (lgtv input 2 = HDMI 2)
  lgtv apps                   list installed apps
  lgtv app <name|id>          launch an app (e.g. lgtv app shahid)
  lgtv open <url>             open a URL in the TV browser
  lgtv youtube <url|id>       play a video in the YouTube app (as the phone's cast button does)
  lgtv ytsearch <query>       search YouTube; one JSON line per video (id, title, channel, ...)
  lgtv notify <message>       show a toast on the TV
  lgtv key <KEY>...           press remote keys (UP DOWN LEFT RIGHT ENTER BACK HOME ...)
  lgtv type [--enter] <text>  type into the TV's on-screen keyboard (e.g. a search box)
  lgtv gridtype <text>        type on Prime Video's or Shahid's own letter grid (search open)
  lgtv remote                 interactive remote in this terminal; typing goes to the
                              TV when its keyboard is open, c toggles a mouse pointer
  lgtv pipe                   one connection driven from stdin, for the bar widget:
                              key NAME · move DX DY · click · scroll DY · text STR ·
                              enter · del [N]; prints {"keyboard": bool} and {"app", "grid"}
                              as they change. Text goes to Prime's/Shahid's letter grid
                              when one of them is on screen
  lgtv cast <file|url>...     play videos on the TV (the cast service, DLNA)
  lgtv pair                   (re)pair; accept the prompt on the TV
  lgtv host                   print the TV's address

Config and pairing key live in ~/.config/lgtv/. LGTV_HOST overrides the TV address.
"""
import asyncio, json, os, re, socket, ssl, subprocess, sys, pathlib, time, uuid
import urllib.parse, urllib.request

CONF_DIR = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "lgtv"
KEYFILE = CONF_DIR / "client-key"
CONFFILE = CONF_DIR / "config.json"
MDNS_NAME = "LGwebOSTV.local"

PERMISSIONS = [
    "LAUNCH", "LAUNCH_WEBAPP", "APP_TO_APP", "CLOSE", "TEST_OPEN", "TEST_PROTECTED",
    "CONTROL_AUDIO", "CONTROL_DISPLAY", "CONTROL_INPUT_JOYSTICK", "CONTROL_INPUT_MEDIA_RECORDING",
    "CONTROL_INPUT_MEDIA_PLAYBACK", "CONTROL_INPUT_TV", "CONTROL_POWER", "CONTROL_TV_SCREEN",
    "CONTROL_TV_STANBY", "CONTROL_MOUSE_AND_KEYBOARD", "CONTROL_INPUT_TEXT",
    "READ_APP_STATUS", "READ_CURRENT_CHANNEL", "READ_INPUT_DEVICE_LIST", "READ_NETWORK_STATE",
    "READ_RUNNING_APPS", "READ_TV_CHANNEL_LIST", "READ_POWER_STATE", "READ_COUNTRY_INFO",
    "READ_SETTINGS", "READ_INSTALLED_APPS", "READ_LGE_SDX", "READ_NOTIFICATIONS",
    "READ_LGE_TV_INPUT_EVENTS", "READ_TV_CURRENT_TIME", "READ_UPDATE_INFO",
    "WRITE_NOTIFICATION_TOAST", "WRITE_NOTIFICATION_ALERT", "WRITE_SETTINGS",
    "SEARCH", "UPDATE_FROM_REMOTE_APP",
]


def die(msg):
    sys.exit(f"lgtv: {msg}")


def load_conf():
    try:
        return json.loads(CONFFILE.read_text())
    except Exception:
        return {}


def save_conf(conf):
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    CONFFILE.write_text(json.dumps(conf, indent=2) + "\n")


def migrate_old_key():
    old = pathlib.Path.home() / ".config" / "lgtv-client-key"
    if old.exists() and not KEYFILE.exists():
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        old.rename(KEYFILE)


def tv_host():
    if os.environ.get("LGTV_HOST"):
        return os.environ["LGTV_HOST"]
    try:
        out = subprocess.run(["avahi-resolve", "-4", "-n", MDNS_NAME],
                             capture_output=True, text=True, timeout=5).stdout.split()
        if len(out) > 1:
            return out[1]
    except Exception:
        pass
    host = load_conf().get("host")
    if not host:
        die(f"can't find the TV ({MDNS_NAME}); set LGTV_HOST")
    return host


def remember(host):
    """Store the TV's address and MAC (for Wake-on-LAN) after a successful connection."""
    conf = load_conf()
    conf["host"] = host
    try:
        m = re.search(r"lladdr ([0-9a-f:]{17})",
                      subprocess.run(["ip", "neigh", "show", host], capture_output=True, text=True).stdout)
        if m:
            conf["mac"] = m.group(1)
    except Exception:
        pass
    save_conf(conf)


def no_verify_ssl():
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx


class TV:
    def __init__(self, host=None, force_pair=False):
        self.host = host or tv_host()
        self.force_pair = force_pair
        self.ws = None
        self.n = 0

    async def __aenter__(self):
        import websockets
        try:
            self.ws = await websockets.connect(f"wss://{self.host}:3001", ssl=no_verify_ssl(),
                                               open_timeout=8, max_size=None)
        except (OSError, asyncio.TimeoutError) as e:
            die(f"TV at {self.host} not reachable ({e}). Is it on? Try: lgtv on")
        await self._register()
        remember(self.host)
        return self

    async def __aexit__(self, *exc):
        await self.ws.close()

    async def _register(self):
        payload = {"forcePairing": False, "pairingType": "PROMPT",
                   "manifest": {"manifestVersion": 1, "appVersion": "1.1", "permissions": PERMISSIONS}}
        if KEYFILE.exists() and not self.force_pair:
            payload["client-key"] = KEYFILE.read_text().strip()
        await self.ws.send(json.dumps({"type": "register", "id": "register", "payload": payload}))
        while True:
            try:
                msg = json.loads(await asyncio.wait_for(self.ws.recv(), 120))
            except asyncio.TimeoutError:
                die("pairing prompt not accepted on the TV (timed out)")
            if msg.get("type") == "registered":
                CONF_DIR.mkdir(parents=True, exist_ok=True)
                KEYFILE.write_text(msg["payload"]["client-key"])
                return
            if msg.get("type") == "error":
                die(f"pairing refused: {msg.get('error')}")
            if msg.get("payload", {}).get("pairingType") == "PROMPT":
                print("Accept the pairing prompt on the TV...", file=sys.stderr)

    async def call(self, uri, payload=None, check=True):
        self.n += 1
        mid = f"req{self.n}"
        msg = {"type": "request", "id": mid, "uri": uri}
        if payload is not None:
            msg["payload"] = payload
        await self.ws.send(json.dumps(msg))
        while True:
            resp = json.loads(await asyncio.wait_for(self.ws.recv(), 15))
            if resp.get("id") != mid:
                continue
            if check and (resp.get("type") == "error" or resp.get("payload", {}).get("returnValue") is False):
                raise RuntimeError(resp.get("error") or resp.get("payload", {}).get("errorText") or resp)
            return resp.get("payload", {})

    async def call_any(self, uris, payload=None):
        """Try several URIs (they differ between webOS versions); return the first that works."""
        err = None
        for uri in uris:
            try:
                return await self.call(uri, payload)
            except RuntimeError as e:
                err = e
        raise err

    async def buttons(self):
        """Open the pointer/button socket for remote-key presses."""
        import websockets
        path = (await self.call("ssap://com.webos.service.networkinput/getPointerInputSocket"))["socketPath"]
        if path.startswith("ws://"):  # newer firmware only serves TLS on 3001
            path = "wss://" + path[5:].replace(":3000/", ":3001/", 1)
        return await websockets.connect(path, ssl=no_verify_ssl() if path.startswith("wss") else None)


async def press(sock, name):
    await sock.send(f"type:button\nname:{name}\n\n")


async def move(sock, dx, dy):
    await sock.send(f"type:move\ndx:{dx}\ndy:{dy}\ndown:0\n\n")


async def click(sock):
    await sock.send("type:click\n\n")


async def scroll(sock, dy):
    await sock.send(f"type:scroll\ndx:0\ndy:{dy}\n\n")


NO_KEYBOARD = ("the TV's system keyboard isn't open. Apps like Plex, YouTube, Prime Video and Shahid draw "
               "their own letter grid, which only takes arrow keys; typing reaches the grey "
               "webOS keyboard (Web Browser, home search, some apps). For Prime Video and "
               "Shahid use: lgtv gridtype <text>; for YouTube: lgtv ytsearch / lgtv youtube.")


# ---------- typing on an app's own letter grid ----------
# Prime Video and Shahid draw their own keyboards, which only take arrow keys.
# We type on them as a person would: screenshot the TV, find the highlighted
# key, then walk the arrows to each letter and press OK. Positions are in the
# 960x540 screenshot; a grid is rows of 6 keys plus a bottom row of wide keys.

class Grid:
    def __init__(self, rows, xs, ys, bottom_y, bottom, ltr, half):
        self.rows, self.xs, self.ys, self.ltr, self.half = rows, xs, ys, ltr, half
        self.by = bottom_y
        # bottom keys: (name, first col, last col, x); UP from one lands on its first
        # col, except the space bar, which remembers the column you came down from
        self.bottom = bottom
        self.B = len(rows)  # the bottom row's index

    def find(self, ch):
        for r, row in enumerate(self.rows):
            if ch in row:
                return r, row.index(ch)
        return None

    def special(self, c):
        return next(i for i, b in enumerate(self.bottom) if b[1] <= c <= b[2])


LATIN = ["abcdef", "ghijkl", "mnopqr", "stuvwx", "yz1234", "567890"]
GRID_APPS = {
    "amazon": ("Prime Video", {
        "en": Grid(LATIN, [94, 127, 160, 193, 226, 259], [86, 119, 152, 185, 218, 251], 283,
                   [("space", 0, 3, 143), ("bksp", 4, 5, 242)], True, 10)}),
    "net.mbc.shahid-lgapp": ("Shahid", {
        "ar": Grid(["ابتثجح", "خدذرزس", "شصضطظع", "غفقكلم", "نهويةئ", "ءؤ1234", "567890"],
                   [892, 855, 818, 781, 744, 707], [121, 158, 195, 232, 269, 306, 343], 380,
                   [("toggle", 0, 0, 892), ("space", 1, 4, 800), ("bksp", 5, 5, 707)], False, 12),
        "en": Grid(LATIN, [707, 744, 781, 818, 855, 892], [121, 158, 195, 232, 269, 306], 343,
                   [("toggle", 0, 0, 707), ("space", 1, 4, 800), ("bksp", 5, 5, 892)], True, 12)}),
}
ARABIC_FOLD = str.maketrans({"أ": "ا", "إ": "ا", "آ": "ا", "ى": "ي"})


def _lum(img, x, y):
    return sum(sum(img.getpixel((x + i, y + j))[:3]) / 3 for i in (-1, 0, 1) for j in (-1, 0, 1)) / 9


def _cell_bg(img, x, y, h):
    """A key's background brightness, sampled inside its corners (clear of the glyph)."""
    return sum(_lum(img, x + dx, y + dy) for dx in (-h, h) for dy in (-h, h)) / 4


def grid_locate(img, layouts):
    """Which layout is showing and where its highlight is: (name, (row, col), on_space) or None."""
    # Of several layouts, the one whose bottom row is lowest and actually drawn
    for name, g in sorted(layouts.items(), key=lambda kv: -kv[1].by):
        if len(layouts) > 1 and max(_lum(img, b[3], g.by) for b in g.bottom) < 80:
            continue
        cells = [((r, c), x, y) for r, y in enumerate(g.ys) for c, x in enumerate(g.xs)]
        cells += [((g.B, b[1]), b[3], g.by) for b in g.bottom]
        scored = sorted(((_cell_bg(img, x, y, g.half), pos) for pos, x, y in cells), reverse=True)
        if scored[0][0] >= 185 and scored[1][0] < 120:  # one white key among dark ones
            return name, scored[0][1]
        return None
    return None


def grid_keys(layouts, lname, pos, ops):
    """Arrow/OK presses that apply ops ([("text", s) | ("del", n)]) from a known position."""
    g = layouts[lname]
    r, c = pos
    memo = None  # the column the space bar will return to, when known
    keys = []

    def fwd(n):  # move n columns (negative: back)
        keys.extend([("RIGHT" if g.ltr else "LEFT") if n > 0 else ("LEFT" if g.ltr else "RIGHT")] * abs(n))

    def up_out():
        nonlocal r, c, memo
        i = g.special(c)
        if g.bottom[i][0] == "space" and memo is None:
            fwd(1)  # unsure where UP from the space bar lands: step off it first
            i += 1
        c = memo if g.bottom[i][0] == "space" else g.bottom[i][1]
        keys.append("UP")
        r, memo = g.B - 1, None

    def goto_cell(tr, tc):
        nonlocal r, c
        if r == g.B:
            up_out()
        keys.extend(["DOWN" if tr > r else "UP"] * abs(tr - r))
        fwd(tc - c)
        r, c = tr, tc

    def goto_special(name):
        nonlocal r, c, memo
        i = next(i for i, b in enumerate(g.bottom) if b[0] == name)
        lo, hi = g.bottom[i][1], g.bottom[i][2]
        if r == g.B:
            j = g.special(c)
            fwd(i - j)
            if i != j:
                memo = None
        else:
            col = min(max(c, lo), hi)
            goto_cell(g.B - 1, col)
            keys.append("DOWN")
            memo = col if name == "space" else None
        r, c = g.B, lo

    for op, arg in ops:
        if op == "del":
            if arg > 0:
                goto_special("bksp")
                keys.extend(["ENTER"] * arg)
            continue
        for ch in arg.lower().translate(ARABIC_FOLD):
            if ch.isspace():
                goto_special("space")
                keys.append("ENTER")
                continue
            if g.find(ch) is None:
                other = next((n for n, o in layouts.items() if n != lname and o.find(ch)), None)
                if other is None:
                    continue  # not on this keyboard
                goto_special("toggle")
                keys.append("ENTER")
                lname, g = other, layouts[other]
                r, c, memo = 0, 0, None
            goto_cell(*g.find(ch))
            keys.append("ENTER")
    return keys


async def tv_screenshot(call):
    """The TV's screen as a PIL image; call(uri) makes the request on the TV's socket."""
    from PIL import Image
    import io
    uri = (await call("ssap://tv/executeOneShot"))["imageUri"]
    data = await asyncio.to_thread(
        lambda: urllib.request.urlopen(uri, context=no_verify_ssl(), timeout=5).read())
    return Image.open(io.BytesIO(data)).convert("RGB")


async def grid_type(call, sock, app, ops):
    """Type ops on the app's letter grid. Returns an error message, or None."""
    title, layouts = GRID_APPS[app]
    found = grid_locate(await tv_screenshot(call), layouts)
    if not found:
        return f"open {title}'s search first: its letter grid isn't on the screen"
    for k in grid_keys(layouts, found[0], found[1], ops):
        await press(sock, k)
        await asyncio.sleep(0.15)
    return None


async def foreground_app(tv):
    return (await tv.call("ssap://com.webos.applicationManager/getForegroundAppInfo")).get("appId", "")


async def cmd_gridtype(tv, args):
    if not args:
        die("usage: lgtv gridtype <text>   (Prime Video or Shahid, with its search open)")
    app = await foreground_app(tv)
    if app not in GRID_APPS:
        die(f"the app on screen ({app or 'none'}) isn't one whose letter grid I know: "
            + ", ".join(t for t, _ in GRID_APPS.values()))
    sock = await tv.buttons()
    try:
        err = await grid_type(lambda uri: tv.call(uri), sock, app, [("text", " ".join(args))])
    finally:
        await sock.close()
    if err:
        die(err)


async def tv_keyboard_open(tv):
    """True if the webOS system keyboard has focus right now."""
    await tv.ws.send(json.dumps({"type": "subscribe", "id": "kbdcheck",
                                 "uri": "ssap://com.webos.service.ime/registerRemoteKeyboard"}))
    try:
        while True:
            msg = json.loads(await asyncio.wait_for(tv.ws.recv(), 0.8))
            widget = msg.get("payload", {}).get("currentWidget") if msg.get("id") == "kbdcheck" else None
            if isinstance(widget, dict) and "focus" in widget:
                return bool(widget["focus"])
    except asyncio.TimeoutError:
        return False


# ---------- commands ----------

async def cmd_status(tv, args):
    try:
        p = await tv.call("ssap://com.webos.service.tvpower/power/getPowerState")
        print("power:  ", p.get("state", "?"))
    except RuntimeError:
        pass
    app = await tv.call("ssap://com.webos.applicationManager/getForegroundAppInfo")
    print("app:    ", app.get("appId") or "?")
    await cmd_vol(tv, [])


async def cmd_vol(tv, args):
    if not args:
        v = await tv.call("ssap://audio/getVolume")
        st = v.get("volumeStatus", v)
        muted = st.get("muteStatus", st.get("muted", False))
        print("volume: ", st.get("volume", "?"), "(muted)" if muted else "")
    elif args[0] in ("up", "+"):
        await tv.call("ssap://audio/volumeUp")
    elif args[0] in ("down", "-"):
        await tv.call("ssap://audio/volumeDown")
    elif args[0].isdigit():
        await tv.call("ssap://audio/setVolume", {"volume": max(0, min(100, int(args[0])))})
    else:
        die("usage: lgtv vol [N|up|down]")


async def cmd_mute(tv, args, on=True):
    await tv.call("ssap://audio/setMute", {"mute": on})


async def cmd_off(tv, args):
    await tv.call("ssap://system/turnOff")


async def cmd_screen(tv, args):
    if not args or args[0] not in ("on", "off"):
        die("usage: lgtv screen off|on")
    verb = "turnOffScreen" if args[0] == "off" else "turnOnScreen"
    await tv.call_any([f"ssap://com.webos.service.tvpower/power/{verb}",
                       f"ssap://com.webos.service.tv.power/{verb}"], {"standbyMode": "active"})


MEDIA = {"play": "play", "pause": "pause", "stop": "stop", "ff": "fastForward", "rew": "rewind"}


async def cmd_media(tv, args, action):
    await tv.call(f"ssap://media.controls/{MEDIA[action]}")


async def cmd_input(tv, args):
    devices = (await tv.call("ssap://tv/getExternalInputList")).get("devices", [])
    if not args:
        for d in devices:
            mark = "" if d.get("connected") else "   (nothing connected)"
            print(f"{d['id']:<12} {d.get('label', '')}{mark}")
        return
    q = args[0]
    want = f"HDMI_{q}" if q.isdigit() else q
    for d in devices:
        if d["id"].lower() == want.lower() or q.lower() in d.get("label", "").lower():
            await tv.call("ssap://tv/switchInput", {"inputId": d["id"]})
            print(f"switched to {d['id']} ({d.get('label', '')})")
            return
    die(f"no input matching {q!r}; see: lgtv input")


async def list_apps(tv):
    lps = (await tv.call("ssap://com.webos.applicationManager/listLaunchPoints")).get("launchPoints", [])
    return sorted(((lp["id"], lp.get("title", "")) for lp in lps), key=lambda a: a[1].lower())


async def cmd_apps(tv, args):
    for aid, title in await list_apps(tv):
        print(f"{title:<28} {aid}")


async def cmd_app(tv, args):
    if not args:
        return await cmd_apps(tv, args)
    q = " ".join(args).lower()
    apps = await list_apps(tv)
    match = ([a for a in apps if a[0].lower() == q or a[1].lower() == q]
             or [a for a in apps if q in a[1].lower() or q in a[0].lower()])
    if not match:
        die(f"no app matching {q!r}; see: lgtv apps")
    await tv.call("ssap://system.launcher/launch", {"id": match[0][0]})
    print(f"launched {match[0][1]}")


async def cmd_open(tv, args):
    if len(args) != 1:
        die("usage: lgtv open <url>")
    await tv.call("ssap://system.launcher/open", {"target": args[0]})


def youtube_id(s):
    m = re.search(r"(?:v=|youtu\.be/|/shorts/|/embed/|/live/)([\w-]{11})", s)
    if m:
        return m.group(1)
    if re.fullmatch(r"[\w-]{11}", s):
        return s
    die(f"can't find a YouTube video id in {s!r}")


# The YouTube app ignores video ids passed at launch now, so play the way a
# phone's cast button does: DIAL (the TV's port 36866) starts the app and names
# its screen, and YouTube's lounge service tells that screen what to play.
DIAL_PORT = 36866
YT_ORIGIN = {"Origin": "https://www.youtube.com"}
LOUNGE = "https://www.youtube.com/api/lounge"


def http(url, data=None, headers=None, timeout=10):
    body = urllib.parse.urlencode(data).encode() if isinstance(data, dict) else data
    req = urllib.request.Request(url, data=body, headers=headers or {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode(errors="ignore")


def youtube_screen(host):
    """Start the YouTube app if needed; return its lounge screen id."""
    url = f"http://{host}:{DIAL_PORT}/apps/YouTube"

    def state():
        xml = http(url, headers=YT_ORIGIN, timeout=5)
        m = re.search(r"<screenId>([^<]+)</screenId>", xml)
        return re.search(r"<state>([^<]*)</state>", xml).group(1), m and m.group(1)

    try:
        st, screen = state()
        if st != "running":
            http(url, b"", headers=YT_ORIGIN, timeout=5)
            for _ in range(30):
                time.sleep(1)
                st, screen = state()
                if st == "running" and screen:
                    break
            time.sleep(5)  # let the app reach YouTube before it's told what to play
    except (OSError, AttributeError) as e:
        die(f"can't reach the TV's YouTube app over DIAL ({e}); is the TV on?")
    if not screen:
        die("the TV's YouTube app didn't give a screen id")
    return screen


def cmd_youtube(args):
    if len(args) != 1:
        die("usage: lgtv youtube <url|id>")
    vid = youtube_id(args[0])
    screen = youtube_screen(tv_host())
    try:
        tok = json.loads(http(f"{LOUNGE}/pairing/get_lounge_token_batch", {"screen_ids": screen}))
        q = {"device": "REMOTE_CONTROL", "id": str(uuid.uuid4()), "name": "lgtv", "app": "youtube-desktop",
             "mdx-version": "3", "loungeIdToken": tok["screens"][0]["loungeToken"], "VER": "8", "v": "2",
             "theme": "cl", "capabilities": "que,dsdtr,atp", "ui": "", "TYPE": "", "CVER": "1", "zx": "x", "t": "1"}
        bind = f"{LOUNGE}/bc/bind?"
        raw = http(bind + urllib.parse.urlencode({**q, "RID": "1"}), {"count": "0"})
        sid = re.search(r'"c","([^"]+)"', raw).group(1)
        gsession = re.search(r'"S","([^"]+)"', raw).group(1)
        http(bind + urllib.parse.urlencode({**q, "RID": "2", "SID": sid, "gsessionid": gsession, "AID": "5"}),
             {"count": "1", "ofs": "0", "req0__sc": "setPlaylist", "req0_videoId": vid,
              "req0_currentTime": "0", "req0_currentIndex": "0", "req0_videoIds": vid,
              "req0_listId": "", "req0_audioOnly": "false"})
    except (OSError, KeyError, IndexError, ValueError, AttributeError) as e:
        die(f"YouTube's lounge service refused the video ({e})")


def cmd_ytsearch(args):
    if not args:
        die("usage: lgtv ytsearch <query>")
    r = subprocess.run(["yt-dlp", "--flat-playlist", "-J", "--no-warnings", "ytsearch15:" + " ".join(args)],
                       capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        die((r.stderr.strip().splitlines() or ["yt-dlp failed"])[-1])
    for e in json.loads(r.stdout).get("entries", []):
        if e.get("id"):
            print(json.dumps({"id": e["id"], "title": e.get("title") or "", "channel": e.get("channel") or "",
                              "duration": e.get("duration"), "live": e.get("live_status") == "is_live",
                              "views": e.get("view_count")}, ensure_ascii=False))


async def cmd_notify(tv, args):
    if not args:
        die("usage: lgtv notify <message>")
    await tv.call("ssap://system.notifications/createToast", {"message": " ".join(args)})


async def cmd_key(tv, args):
    if not args:
        die("usage: lgtv key UP|DOWN|LEFT|RIGHT|ENTER|BACK|HOME|EXIT|MENU|INFO|VOLUMEUP|... (several allowed)")
    sock = await tv.buttons()
    try:
        for k in args:
            await press(sock, k.upper())
            await asyncio.sleep(0.15)
    finally:
        await sock.close()


async def cmd_type(tv, args):
    enter = "--enter" in args
    text = " ".join(a for a in args if a != "--enter")
    if not text and not enter:
        die("usage: lgtv type [--enter] <text>   (with the TV's keyboard open)")
    if not await tv_keyboard_open(tv):
        print(f"lgtv: warning: {NO_KEYBOARD}", file=sys.stderr)
    if text:
        await tv.call("ssap://com.webos.service.ime/insertText", {"text": text, "replace": 0})
    if enter:
        await tv.call("ssap://com.webos.service.ime/sendEnterKey")


REMOTE_HELP = """remote: arrows move · Enter OK · Backspace back · h home · i info · s settings
        + / - volume · m mute · space pause · p play · Tab typing · c mouse · q quit
        Typing: when the TV shows its system keyboard, typing goes to it; Esc or Tab
        returns to remote keys. (Plex/YouTube/Prime/Shahid grids take arrow keys only.)
        Mouse: arrows move the pointer (Shift = faster), Enter/space click,
        PgUp/PgDn scroll, Backspace back, Esc or c returns. Ctrl-C quits."""
REMOTE_KEYS = {"\x1b[A": "UP", "\x1b[B": "DOWN", "\x1b[C": "RIGHT", "\x1b[D": "LEFT",
               "\r": "ENTER", "\n": "ENTER", "\x7f": "BACK", "\x08": "BACK", "h": "HOME",
               "i": "INFO", "s": "MENU", "+": "VOLUMEUP", "=": "VOLUMEUP", "-": "VOLUMEDOWN",
               "m": "MUTE", " ": "PAUSE", "p": "PLAY"}
ARROWS = {k: v for k, v in REMOTE_KEYS.items() if k.startswith("\x1b[")}
# Mouse mode: escape sequences -> (dx, dy). Shift+arrow (\x1b[1;2X) moves further.
MOUSE_STEP, MOUSE_FAST = 30, 120
MOUSE_DIRS = {"A": (0, -1), "B": (0, 1), "C": (1, 0), "D": (-1, 0)}
MOUSE_TOKENS = re.compile(r"\x1b\[1;2([ABCD])|\x1b\[([ABCD])|\x1b\[([56])~|\x1b|.", re.S)


async def cmd_remote(tv, args):
    import termios, tty
    if not sys.stdin.isatty():
        die("remote needs a terminal")
    print(REMOTE_HELP)
    sock = await tv.buttons()
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    loop = asyncio.get_running_loop()
    state = {"typing": False, "tv_keyboard": False, "mouse": False}

    def show(msg):
        sys.stdout.write(f"\r\x1b[K{msg}")
        sys.stdout.flush()

    def mode_line():
        if state["mouse"]:
            show("🖱  mouse  (arrows move, Shift faster, Enter click, PgUp/PgDn scroll, Esc/c: remote keys)")
        elif state["typing"] and state["tv_keyboard"]:
            show("⌨  typing on the TV  (Esc/Tab: remote keys)")
        elif state["typing"]:
            show("⌨  typing, but no TV system keyboard is open (Plex/YouTube grids: use arrows)")
        else:
            show("🎮 remote keys")

    async def mouse_input(s):
        """Handle a chunk of input in mouse mode; held keys arrive as several sequences."""
        dx = dy = 0
        for m in MOUSE_TOKENS.finditer(s):
            fast, arrow, page = m.group(1), m.group(2), m.group(3)
            tok = m.group(0)
            if fast or arrow:
                ux, uy = MOUSE_DIRS[fast or arrow]
                step = MOUSE_FAST if fast else MOUSE_STEP
                dx, dy = dx + ux * step, dy + uy * step
                continue
            if dx or dy:
                await move(sock, dx, dy)
                dx = dy = 0
            if page:
                await scroll(sock, -3 if page == "5" else 3)
            elif tok in ("\r", "\n", " "):
                await click(sock)
            elif tok in ("\x7f", "\x08"):
                await press(sock, "BACK")
            elif tok in ("\x1b", "c"):
                state["mouse"] = False
                mode_line()
                return
            elif tok == "h":
                await press(sock, "HOME")
        if dx or dy:
            await move(sock, dx, dy)

    # From here on only reader() reads the main socket; requests are sent without waiting.
    n = 0

    async def send(uri, payload=None):
        nonlocal n
        n += 1
        msg = {"type": "request", "id": f"rk{n}", "uri": uri}
        if payload is not None:
            msg["payload"] = payload
        await tv.ws.send(json.dumps(msg))

    async def reader():
        """Follow the TV's keyboard: typing mode switches on when it opens, off when it closes."""
        async for raw in tv.ws:
            try:
                msg = json.loads(raw)
            except ValueError:
                continue
            if msg.get("id") != "kbd":
                continue
            widget = msg.get("payload", {}).get("currentWidget")
            if not isinstance(widget, dict) or "focus" not in widget:
                continue
            focus = bool(widget["focus"])
            if focus != state["tv_keyboard"]:
                state["tv_keyboard"] = state["typing"] = focus
                if not state["mouse"]:
                    mode_line()

    await tv.ws.send(json.dumps({"type": "subscribe", "id": "kbd",
                                 "uri": "ssap://com.webos.service.ime/registerRemoteKeyboard"}))
    watch = asyncio.create_task(reader())
    try:
        tty.setraw(fd)
        mode_line()
        while True:
            s = (await loop.run_in_executor(None, os.read, fd, 1024)).decode(errors="ignore")
            if not s or s in ("\x03", "\x04"):
                break
            if state["mouse"]:
                await mouse_input(s)
            elif s == "\t":
                state["typing"] = not state["typing"]
                mode_line()
            elif state["typing"]:
                if s == "\x1b":
                    state["typing"] = False
                    mode_line()
                elif s in ARROWS:
                    await press(sock, ARROWS[s])
                elif s in ("\r", "\n"):
                    await send("ssap://com.webos.service.ime/sendEnterKey")
                elif s in ("\x7f", "\x08"):
                    await send("ssap://com.webos.service.ime/deleteCharacters", {"count": 1})
                elif s.isprintable():  # one key, or a whole pasted string
                    await send("ssap://com.webos.service.ime/insertText", {"text": s, "replace": 0})
            elif s == "q":
                break
            elif s == "c":
                state["mouse"] = True
                mode_line()
                await move(sock, 0, 0)  # wakes the pointer so it shows up
            elif s in REMOTE_KEYS:
                await press(sock, REMOTE_KEYS[s])
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        watch.cancel()
        await sock.close()
        print()


async def cmd_pipe(tv, args):
    """Read commands from stdin, one per line; report the TV keyboard on stdout as JSON."""
    sock = await tv.buttons()
    loop = asyncio.get_running_loop()
    reader = asyncio.StreamReader()
    await loop.connect_read_pipe(lambda: asyncio.StreamReaderProtocol(reader), sys.stdin)
    n = 0

    def emit(**kw):
        print(json.dumps(kw), flush=True)

    async def send(uri, payload=None):
        nonlocal n
        n += 1
        msg = {"type": "request", "id": f"p{n}", "uri": uri}
        if payload is not None:
            msg["payload"] = payload
        await tv.ws.send(json.dumps(msg))

    waiting = {}  # request id -> future, for the replies we wait on
    state = {"keyboard": False, "app": ""}

    async def call(uri, payload=None):
        nonlocal n
        n += 1
        fut = waiting[f"w{n}"] = loop.create_future()
        msg = {"type": "request", "id": f"w{n}", "uri": uri}
        if payload is not None:
            msg["payload"] = payload
        await tv.ws.send(json.dumps(msg))
        try:
            return await asyncio.wait_for(fut, 10)
        finally:
            waiting.pop(f"w{n}", None)

    async def watch():
        async for raw in tv.ws:
            try:
                msg = json.loads(raw)
            except ValueError:
                continue
            mid, payload = msg.get("id"), msg.get("payload", {})
            if mid in waiting:
                waiting[mid].set_result(payload)
            elif mid == "kbd":
                widget = payload.get("currentWidget")
                if isinstance(widget, dict) and "focus" in widget and bool(widget["focus"]) != state["keyboard"]:
                    state["keyboard"] = bool(widget["focus"])
                    emit(keyboard=state["keyboard"])
            elif mid == "fg" and "appId" in payload and payload["appId"] != state["app"]:
                state["app"] = payload["appId"]
                emit(app=state["app"], grid=GRID_APPS.get(state["app"], ("",))[0])

    async def grid(first):
        """Type on the app's letter grid: gather what follows within a moment, walk once."""
        ops, pushback = [first], None
        while True:
            try:
                nxt = await asyncio.wait_for(reader.readline(), 0.35)
            except asyncio.TimeoutError:
                break
            c, _, a = nxt.decode(errors="ignore").rstrip("\n").partition(" ")
            if c == "text" and a:
                ops.append(("text", a))
            elif c == "del":
                ops.append(("del", int(a or 1)))
            else:
                pushback = nxt
                break
        try:
            err = await grid_type(call, sock, state["app"], ops)
        except (OSError, asyncio.TimeoutError, KeyError, ValueError) as e:
            err = f"couldn't read the TV's screen ({e})"
        emit(grid_error=err or "")
        return pushback

    await tv.ws.send(json.dumps({"type": "subscribe", "id": "kbd",
                                 "uri": "ssap://com.webos.service.ime/registerRemoteKeyboard"}))
    await tv.ws.send(json.dumps({"type": "subscribe", "id": "fg",
                                 "uri": "ssap://com.webos.applicationManager/getForegroundAppInfo"}))
    watcher = asyncio.create_task(watch())
    emit(ready=True, keyboard=False)
    pending = None
    try:
        while True:
            line, pending = pending or await reader.readline(), None
            if not line:
                break
            cmd, _, rest = line.decode(errors="ignore").rstrip("\n").partition(" ")
            on_grid = not state["keyboard"] and state["app"] in GRID_APPS
            try:
                if on_grid and cmd == "text" and rest:
                    pending = await grid(("text", rest))
                elif on_grid and cmd == "del":
                    pending = await grid(("del", int(rest or 1)))
                elif on_grid and cmd == "enter":
                    pass  # these apps search as you type
                elif cmd == "key" and rest:
                    await press(sock, rest.strip().upper())
                elif cmd == "move":
                    dx, dy = (int(float(v)) for v in rest.split()[:2])
                    await move(sock, dx, dy)
                elif cmd == "click":
                    await click(sock)
                elif cmd == "scroll":
                    await scroll(sock, int(float(rest or 0)))
                elif cmd == "text" and rest:
                    await send("ssap://com.webos.service.ime/insertText", {"text": rest, "replace": 0})
                elif cmd == "enter":
                    await send("ssap://com.webos.service.ime/sendEnterKey")
                elif cmd == "del":
                    await send("ssap://com.webos.service.ime/deleteCharacters", {"count": int(rest or 1)})
            except ValueError:
                pass
            if watcher.done():
                break  # the TV went away
    finally:
        watcher.cancel()
        await sock.close()


async def cmd_pair(tv, args):
    print("paired.")


# ---------- no websocket needed ----------

def cmd_on(args):
    mac = load_conf().get("mac")
    if not mac:
        die("no MAC address saved yet; run any lgtv command once while the TV is on")
    packet = b"\xff" * 6 + bytes.fromhex(mac.replace(":", "")) * 16
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    host = load_conf().get("host", "")
    targets = {"255.255.255.255"}
    if host.count(".") == 3:
        targets.add(host.rsplit(".", 1)[0] + ".255")
    for t in targets:
        for port in (9, 7):
            s.sendto(packet, (t, port))
    print("wake packet sent (needs TV setting: General > Devices > TV Management/Mobile TV On > Turn on via Wi-Fi)")


def cmd_cast(args):
    if not args:
        die("usage: lgtv cast <file|dir|url>...   (see: cast --help)")
    os.execvp("cast", ["cast", "play", *args])


COMMANDS = {
    "status": cmd_status, "vol": cmd_vol, "volume": cmd_vol,
    "mute": lambda tv, a: cmd_mute(tv, a, True), "unmute": lambda tv, a: cmd_mute(tv, a, False),
    "off": cmd_off, "screen": cmd_screen, "input": cmd_input, "hdmi": cmd_input,
    "apps": cmd_apps, "app": cmd_app, "open": cmd_open,
    "notify": cmd_notify, "key": cmd_key, "type": cmd_type, "gridtype": cmd_gridtype, "remote": cmd_remote, "pipe": cmd_pipe, "pair": cmd_pair,
    **{m: (lambda m: lambda tv, a: cmd_media(tv, a, m))(m) for m in MEDIA},
}


async def run(cmd, args):
    async with TV(force_pair=(cmd == "pair")) as tv:
        try:
            await COMMANDS[cmd](tv, args)
        except RuntimeError as e:
            die(f"{cmd} failed: {e}")


def main():
    migrate_old_key()
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, args = argv[0], argv[1:]
    if cmd == "on":
        return cmd_on(args)
    if cmd == "cast":
        return cmd_cast(args)
    if cmd in ("youtube", "yt"):
        return cmd_youtube(args)
    if cmd == "ytsearch":
        return cmd_ytsearch(args)
    if cmd == "host":
        return print(tv_host())
    if cmd not in COMMANDS:
        die(f"unknown command {cmd!r}; see: lgtv --help")
    asyncio.run(run(cmd, args))


if __name__ == "__main__":
    main()
