#!/usr/bin/env bash
# What a machine with Home Manager on its own (the Arch ones, and spark on Ubuntu) needs
# from this repo that only root can put in place, which Home Manager, running as me,
# can't: two files, and the firewall rules of a host that lists any. `just switch` runs
# this first: when it all matches the repo it does nothing and asks for nothing; when
# something differs it shows the difference and puts it right with sudo.
#
#   /etc/nix/nix.conf                    from arch/nix.conf
#   /etc/pacman.d/hooks/spicetify.hook   from arch/spicetify.hook, on Arch only
#   ufw's rules                          from arch/<host>.ufw, for a host that has one
#
# The hook opens /opt/spotify to spicetify only from Spotify's next install or upgrade
# on, so a Spotify that was there before the hook is opened here.
#
# The firewall only gains rules: one that's listed and missing is added, none is removed.
#
# usage: arch-system [--check]   --check lists what differs and exits 1 if anything does
set -euo pipefail
cd "$(dirname "$0")/.."

nix_conf=/etc/nix/nix.conf
hook=/etc/pacman.d/hooks/spicetify.hook
ufw_list=arch/$(hostname -s).ufw
ufw_rules=/etc/ufw/user.rules

todo=()
cmp -s arch/nix.conf "$nix_conf" || todo+=(nix.conf)
# A pacman hook is no use where there's no pacman to run it
if [[ -e /etc/arch-release ]]; then
  cmp -s arch/spicetify.hook "$hook" || todo+=(spicetify.hook)
fi
if [[ -d /opt/spotify/Apps ]] && ! [[ -w /opt/spotify && -w /opt/spotify/Apps ]]; then
  todo+=(spotify-writable)
fi

# The lines of arch/<host>.ufw ("<tcp|udp> <port> <from>") that ufw has no rule for,
# going by its own record of them, which takes no root to read
missing_rules=()
if [[ -f $ufw_list ]] && command -v ufw >/dev/null; then
  have=$(sed -n 's/^### tuple ### //p' "$ufw_rules" 2>/dev/null | sed 's/ comment=.*//') || true
  while read -r proto port from; do
    grep -qxF "allow $proto $port 0.0.0.0/0 any $from in" <<<"$have" ||
      missing_rules+=("$proto $port $from")
  done < <(grep -Ev '^[[:space:]]*(#|$)' "$ufw_list")
fi
[[ ${#missing_rules[@]} -eq 0 ]] || todo+=(firewall)

# What installing the repo's $1 over $2 changes
show() {
  if [[ -e $2 ]]; then
    diff -u --label "$2 (now)" --label "$1" "$2" "$1" || true
  else
    echo "$2 is missing; $1 goes there"
  fi
}

if [[ ${1:-} == --check ]]; then
  for t in "${todo[@]}"; do echo "differs: $t"; done
  [[ ${#todo[@]} -eq 0 ]]
  exit
fi
[[ ${#todo[@]} -eq 0 ]] && exit 0

for t in "${todo[@]}"; do
  case $t in
    nix.conf) show arch/nix.conf "$nix_conf" ;;
    spicetify.hook) show arch/spicetify.hook "$hook" ;;
    spotify-writable) echo "/opt/spotify isn't writable, so spicetify can't theme Spotify" ;;
    firewall)
      for rule in "${missing_rules[@]}"; do
        read -r proto port from <<<"$rule"
        echo "the firewall doesn't let in $proto port $port from $from ($ufw_list)"
      done
      ;;
  esac
done
echo "sudo puts this right (${todo[*]}):"

for t in "${todo[@]}"; do
  case $t in
    nix.conf)
      sudo install -Dm644 arch/nix.conf "$nix_conf"
      sudo systemctl restart nix-daemon
      ;;
    spicetify.hook)
      sudo install -Dm644 arch/spicetify.hook "$hook"
      ;;
    spotify-writable)
      sudo chmod a+wr /opt/spotify
      sudo chmod -R a+wr /opt/spotify/Apps
      ;;
    firewall)
      for rule in "${missing_rules[@]}"; do
        read -r proto port from <<<"$rule"
        sudo ufw allow from "$from" to any port "$port" proto "$proto"
      done
      ;;
  esac
done
