#!/usr/bin/env bash
# The root-owned side of an Arch (Omarchy) machine: /etc/nix/nix.conf, the pacman hook
# that keeps Spotify patchable, and so on, declared in modules/arch-system and applied
# with system-manager. Run by `just switch` before Home Manager. Builds as you, and asks
# for sudo only when the result differs from what's active.
#
#   scripts/arch-system [host]           build, and switch if it changed
#   scripts/arch-system --check [host]   exit 1 if a switch is due
set -euo pipefail
cd "$(dirname "$0")/.."

check=""
if [[ ${1:-} == --check ]]; then check=1; shift; fi
host="${1:-$(hostname -s)}"

new="$(nix build --no-link --print-out-paths ".#systemConfigs.$host")"
active="$(readlink -f /nix/var/nix/profiles/system-manager-profiles/system-manager 2>/dev/null || true)"
[[ $new == "$active" ]] && exit 0

if [[ -n $check ]]; then
  echo "system-manager: a switch is due for $host"
  exit 1
fi
echo "System setup changed (modules/arch-system); switching needs sudo"
nix run --inputs-from . system-manager -- switch --store-path "$new" --sudo
