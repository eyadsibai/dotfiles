#!/usr/bin/env bash
# Catches the two ways an Omarchy update gets past the links in files/.
#
# 1. Detached links. A migration (or the bar's settings) that writes a temp file and
#    mv's it into place replaces the symlink with a plain file. The repo keeps the old
#    copy, and the next `just switch` moves the new one aside as *.hm-backup and links
#    the old one back: the update is silently reverted. `adopt` copies the live file
#    into the repo and puts the link back, so git diff shows what Omarchy changed.
#
# 2. Skipped migrations. Some migrations step aside on purpose when they see a
#    symlink ("dotfile managers may own the file"), so their change never lands.
#    Every migration that ran since the last review and names a linked file is
#    listed; `adopt` marks them reviewed.
#
#   check   list both (default; what the post-update hook runs)
#   guard   exit 1 if anything is detached (run before `just switch`)
#   adopt   fix detached links, mark migrations reviewed
#   relink  fix detached links only (the shell.json sync unit runs this)
set -euo pipefail
cd "$(dirname "$0")/.."

mode=${1:-check}
repo=$PWD
gen=$(readlink -f "${XDG_STATE_HOME:-$HOME/.local/state}/home-manager/gcroots/current-home" 2>/dev/null || true)
[[ -d $gen/home-files ]] || { echo "No Home Manager generation found."; exit 0; }
migrations=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/migrations
stamp=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/migrations-reviewed
problems=0

# Linked paths, relative to $HOME (read -r: systemd names hold backslashes)
mapfile -t linked < <(cd "$gen/home-files" && find . \( -type f -o -type l \) -printf '%P\n' | sort)

for rel in "${linked[@]}"; do
  live=$HOME/$rel
  [[ -L $live || ! -f $live ]] && continue
  link=$(readlink "$gen/home-files/$rel")   # the home-manager-files path HM links to
  source=$(readlink -f "$gen/home-files/$rel")
  problems=1
  if [[ $source != "$repo"/* ]]; then
    echo "detached  ~/$rel  (generated by a Nix module: carry the change over by hand, then rm it and switch)"
    continue
  fi
  if [[ $mode == adopt || $mode == relink ]]; then
    cp -- "$live" "$source"
    ln -sfn -- "$link" "$live"
    echo "adopted   ~/$rel -> ${source#"$repo"/}"
  else
    cmp -s -- "$live" "$source" && note="same as the repo" || note="differs from ${source#"$repo"/}"
    echo "detached  ~/$rel  (a plain file now, $note)"
  fi
done

[[ $mode == relink ]] && exit 0

if [[ $mode == guard ]]; then
  ((problems)) && { echo "Run \`just omarchy-adopt\` first, or this switch reverts those files."; exit 1; }
  exit 0
fi

# Migrations since the last review that name a linked file under ~/.config
if [[ -d $migrations ]]; then
  # A linked path as a migration writes it: ~/.config/<x> or ${XDG_CONFIG_HOME:-...}/<x>
  pattern=$(printf '%s\n' "${linked[@]}" | sed -n 's|^\.config/||p' | sed 's/[][\.*^$|+?(){}]/\\&/g' | paste -sd'|')
  newer=()
  [[ -f $stamp ]] && newer=(-newer "$stamp")
  while IFS= read -r ran; do
    script=${OMARCHY_PATH:-/usr/share/omarchy}/migrations/$(basename "$ran")
    [[ -f $script ]] || continue
    hits=$(grep -oE "(\.config/|\}/)($pattern)" "$script" | sed -E 's#^(\.config/|\}/)##' | sort -u | paste -sd' ' || true)
    [[ -n $hits ]] || continue
    problems=1
    printf 'migration %s  %s\n          touches: %s\n' "$(basename "$ran" .sh)" \
      "$(sed -n 's/^echo "\(.*\)"$/\1/p' "$script" | head -1)" "$hits"
  done < <(find "$migrations" -maxdepth 1 -name '*.sh' "${newer[@]}" | sort)
fi

if [[ $mode == adopt ]]; then
  mkdir -p "$(dirname "$stamp")" && touch "$stamp"
  echo "Migrations marked reviewed. Look over git diff and commit."
elif ((problems)); then
  echo "Check each migration's change landed (git diff, or less the script); then \`just omarchy-adopt\`."
else
  echo "Links intact; no unreviewed migrations touch linked files."
fi
