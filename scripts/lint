#!/usr/bin/env bash
# Repo-wide lint: statix + deadnix for Nix, shellcheck for shell scripts, ruff for Python.
# Called by `just lint`, `just check`, and CI (.github/workflows/check.yml).
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

run_tool() {
  local tool=$1
  shift
  if command -v "$tool" >/dev/null 2>&1; then
    "$tool" "$@"
  else
    nix run --inputs-from . "nixpkgs#$tool" -- "$@"
  fi
}

sh_files=()
py_files=()
while IFS= read -r -d '' path; do
  [[ $path == omarchy-defaults/* || ! -f $path || -L $path ]] && continue
  IFS= read -r first <"$path" || true
  case $path in
    *.sh | *.bash) sh_files+=("$path") ;;
    *.py) py_files+=("$path") ;;
    *)
      if [[ $first =~ ^#!.*(/|[[:space:]])(ba|da|k|a)?sh([[:space:]]|$) ]]; then
        sh_files+=("$path")
      elif [[ $first =~ ^#!.*(python[0-9.]*|uv[[:space:]]+run) ]]; then
        py_files+=("$path")
      fi
      ;;
  esac
done < <(git ls-files -z)

failed=0

echo "lint: statix"
run_tool statix check . || failed=1

echo "lint: deadnix"
run_tool deadnix --fail --exclude hosts/eyad-nixos/hardware-configuration.nix . || failed=1

if ((${#sh_files[@]})); then
  echo "lint: shellcheck (${#sh_files[@]} files)"
  run_tool shellcheck "${sh_files[@]}" || failed=1
fi

if ((${#py_files[@]})); then
  echo "lint: ruff (${#py_files[@]} files)"
  run_tool ruff check "${py_files[@]}" || failed=1
fi

exit "$failed"
